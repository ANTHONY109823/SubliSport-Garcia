@using SubliSport.Domain.Enums
@using SubliSport.Domain.Orders

@page "/pedidos/nuevo"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

<PageTitle>Nuevo pedido - SUBLISPORT GARCIA</PageTitle>

<h1 class="page-title">Registrar pedido</h1>
<p class="page-subtitle">Solo lo esencial — el diseñador completa tallas y detalles técnicos</p>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert-success">@message</div>
}
@if (!string.IsNullOrEmpty(error))
{
    <div class="alert-error">@error</div>
}

<EditForm Model="model" FormName="createOrderForm" OnValidSubmit="HandleSubmit" class="form-panel form-quick-order">
    <DataAnnotationsValidator />

    <section class="panel-section form-section-compact">
        <h2>1. Cliente</h2>
        <div class="form-grid form-grid-2">
            <div class="form-group form-group-span2">
                <label>@UiLabelHelper.Label(ui, UiPanelKeys.AdminCreateOrder, "clientName", "Nombre del cliente") *</label>
                <InputText @bind-value="model.ClientName" class="form-control" placeholder="Ej. Club Deportivo Lima" />
                <ValidationMessage For="() => model.ClientName" />
            </div>
            <div class="form-group">
                <label>@UiLabelHelper.Label(ui, UiPanelKeys.AdminCreateOrder, "clientPhone", "Teléfono / WhatsApp")</label>
                <InputText @bind-value="model.ClientPhone" class="form-control" placeholder="999 999 999" />
            </div>
        </div>
    </section>

    <section class="panel-section form-section-compact">
        <h2>2. Pedido</h2>
        <div class="form-grid">
            <div class="form-group">
                <label>@UiLabelHelper.Label(ui, UiPanelKeys.AdminCreateOrder, "garmentType", "Tipo de prenda") *</label>
                <InputSelect @bind-value="model.GarmentType" class="form-control">
                    @foreach (var type in UiLabelHelper.GarmentTypes(ui))
                    {
                        <option value="@type">@type</option>
                    }
                </InputSelect>
                @if (model.GarmentType == "Otro")
                {
                    <InputText @bind-value="model.GarmentTypeOther" class="form-control form-control-mt" placeholder="Especifique prenda" />
                }
            </div>
            <div class="form-group">
                <label>@UiLabelHelper.Label(ui, UiPanelKeys.AdminCreateOrder, "sport", "Deporte") *</label>
                <InputSelect @bind-value="model.Sport" class="form-control">
                    @foreach (var sport in UiLabelHelper.Sports(ui))
                    {
                        <option value="@sport">@sport</option>
                    }
                </InputSelect>
                @if (model.Sport == "Otro")
                {
                    <InputText @bind-value="model.SportOther" class="form-control form-control-mt" placeholder="Especifique deporte" />
                }
            </div>
            <div class="form-group">
                <label>@UiLabelHelper.Label(ui, UiPanelKeys.AdminCreateOrder, "quantity", "Cantidad (aprox.)") @(model.GarmentType == "Mixta" ? "" : "*")</label>
                @if (model.GarmentType == "Mixta")
                {
                    <p class="field-hint">Se calcula automáticamente según el detalle mixto.</p>
                }
                else
                {
                    <InputNumber @bind-value="model.Quantity" class="form-control" />
                    <ValidationMessage For="() => model.Quantity" />
                }
            </div>
            <div class="form-group">
                <label>@UiLabelHelper.Label(ui, UiPanelKeys.AdminCreateOrder, "agreedDeliveryDate", "Fecha de entrega") *</label>
                <InputDate @bind-value="model.AgreedDeliveryDate" class="form-control" />
            </div>
            <div class="form-group">
                <label>Fecha de recepción *</label>
                <InputDate @bind-value="model.ReceivedAt" class="form-control" />
                <span class="field-hint">Orden de ingreso en la cola — use la fecha real en que llegó el pedido.</span>
            </div>
        </div>

        @if (model.GarmentType == "Mixta")
        {
            <div class="form-group mixed-garment-section">
                <label>Detalle pedido mixto *</label>
                <p class="field-hint">Agregue cada tipo de prenda y cantidad (ej. 10 conjuntos + 5 polos).</p>
                @for (var i = 0; i < model.MixedLines.Count; i++)
                {
                    var line = model.MixedLines[i];
                    var index = i;
                    <div class="mixed-line-row">
                        <select @bind="line.ItemType" class="form-control">
                            @foreach (var itemType in OrderFormOptions.MixedGarmentItemTypes)
                            {
                                <option value="@itemType">@itemType</option>
                            }
                        </select>
                        @if (line.ItemType == "Otro")
                        {
                            <input type="text" @bind="line.OtherDescription" class="form-control" placeholder="Especifique" />
                        }
                        <input type="number" min="1" @bind="line.Quantity" class="form-control mixed-qty" />
                        @if (model.MixedLines.Count > 1)
                        {
                            <button type="button" class="btn-action btn-warn" @onclick="() => RemoveMixedLine(index)">✕</button>
                        }
                    </div>
                }
                <button type="button" class="btn-secondary" @onclick="AddMixedLine">+ Agregar prenda</button>
            </div>
        }

        <div class="form-group">
            <label>@UiLabelHelper.Label(ui, UiPanelKeys.AdminCreateOrder, "priority", "Prioridad")</label>
            <div class="priority-chips">
                @foreach (var p in OrderFormOptions.PriorityQuick)
                {
                    <button type="button"
                            class="priority-chip priority-@p.Value.ToString().ToLower() @(model.Priority == p.Value ? "active" : "")"
                            @onclick="() => model.Priority = p.Value">
                        @p.Label
                    </button>
                }
            </div>
        </div>

        <div class="form-group">
            <label>@UiLabelHelper.Label(ui, UiPanelKeys.AdminCreateOrder, "notes", "Nota breve (opcional)")</label>
            <InputText @bind-value="model.Notes" class="form-control" placeholder="Ej. Uniforme titular + suplente, colores rojo/negro" />
        </div>

        <div class="form-group">
            <label>Obsequio (opcional)</label>
            <div class="priority-chips">
                @foreach (var gift in GiftOptionHelper.Options)
                {
                    <button type="button"
                            class="priority-chip @(model.GiftOption == gift.Value ? "active" : "")"
                            @onclick="() => model.GiftOption = gift.Value">
                        @gift.Label
                    </button>
                }
            </div>
        </div>
    </section>

    <section class="panel-section form-section-compact">
        <h2>3. Asignar diseñador (opcional)</h2>
        <p class="field-hint">Si ya sabe quién lo tomará, asígnelo ahora y ahorre un paso.</p>
        <div class="designer-picker">
            <button type="button"
                    class="designer-card @(string.IsNullOrEmpty(model.DesignerId) ? "selected" : "")"
                    @onclick="() => model.DesignerId = null">
                <strong>Sin asignar aún</strong>
                <span>Asignar después desde el pedido</span>
            </button>
            @foreach (var designer in designers)
            {
                var load = designerLoads.GetValueOrDefault(designer.Id, 0);
                var stats = designerStats.GetValueOrDefault(designer.Id);
                <button type="button"
                        class="designer-card @(model.DesignerId == designer.Id ? "selected" : "")"
                        @onclick="() => model.DesignerId = designer.Id">
                    <strong>@designer.FullName</strong>
                    <span>@load en curso · @(stats?.CompletedThisWeek ?? 0) sem · @(stats?.CompletedThisMonth ?? 0) mes · @(stats?.CompletedTotal ?? 0) total</span>
                </button>
            }
        </div>
    </section>

    <div class="form-actions-sticky">
        <button type="submit" class="btn-primary btn-primary-lg" disabled="@isSaving">
            @(isSaving ? "Guardando..." : "Registrar pedido")
        </button>
        <a href="/pedidos" class="btn-secondary">Cancelar</a>
    </div>
</EditForm>

@code {
    [Inject] private OrderService OrderService { get; set; } = default!;
    [Inject] private MetricsService MetricsService { get; set; } = default!;
    [Inject] private PanelUiConfigurationService PanelUiConfig { get; set; } = default!;
    [Inject] private UserManagementService UserManagementService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private readonly CreateOrderModel model = new();
    private PanelUiSettingsData ui = PanelUiSettingsData.CreateDefault();
    private List<ApplicationUser> designers = [];
    private Dictionary<string, int> designerLoads = new();
    private Dictionary<string, DesignerLeaderboardEntry> designerStats = new();
    private bool isSaving;
    private string? message;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        ui = await PanelUiConfig.GetSettingsAsync();
        designers = await UserManagementService.GetDesignersAsync();
        var activeDesigners = designers.Where(d => d.IsActive).ToList();
        designers = activeDesigners;

        var auth = await AuthState;
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId is null) return;

        var roles = auth.User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value);
        var orders = await OrderService.GetOrdersForUserAsync(userId, roles);
        designerLoads = orders
            .Where(o => o.AssignedDesignerId is not null &&
                        o.Status is OrderStatus.AsignadoDiseno or OrderStatus.EnDiseno)
            .GroupBy(o => o.AssignedDesignerId!)
            .ToDictionary(g => g.Key, g => g.Count());

        var leaderboard = await MetricsService.GetDesignerLeaderboardAsync();
        designerStats = leaderboard.ToDictionary(e => e.DesignerId);
    }

    private void AddMixedLine() =>
        model.MixedLines.Add(new MixedGarmentLineModel { ItemType = OrderFormOptions.MixedGarmentItemTypes[0], Quantity = 1 });

    private void RemoveMixedLine(int index)
    {
        if (model.MixedLines.Count > 1)
        {
            model.MixedLines.RemoveAt(index);
        }
    }

    private async Task HandleSubmit()
    {
        isSaving = true;
        error = null;
        message = null;

        var auth = await AuthState;
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId is null)
        {
            error = "Sesión inválida.";
            isSaving = false;
            return;
        }

        var garment = model.GarmentType == "Otro" ? model.GarmentTypeOther?.Trim() : model.GarmentType;
        var sport = model.Sport == "Otro" ? model.SportOther?.Trim() : model.Sport;

        if (string.IsNullOrWhiteSpace(garment))
        {
            error = "Indique el tipo de prenda.";
            isSaving = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(sport))
        {
            error = "Indique el deporte.";
            isSaving = false;
            return;
        }

        string? mixedJson = null;
        var quantity = model.Quantity;

        if (model.GarmentType == "Mixta")
        {
            var validLines = model.MixedLines
                .Where(l => l.Quantity > 0 && !string.IsNullOrWhiteSpace(l.ItemType))
                .Select(l => new MixedGarmentLine
                {
                    ItemType = l.ItemType,
                    Quantity = l.Quantity,
                    OtherDescription = l.ItemType == "Otro" ? l.OtherDescription?.Trim() : null
                })
                .ToList();

            if (validLines.Count == 0)
            {
                error = "Agregue al menos una prenda al pedido mixto.";
                isSaving = false;
                return;
            }

            mixedJson = MixedGarmentHelper.Serialize(validLines);
            quantity = validLines.Sum(l => l.Quantity);
            garment = "Mixta";
        }

        if (model.ReceivedAt is null)
        {
            error = "Indique la fecha de recepción.";
            isSaving = false;
            return;
        }

        try
        {
            var order = await OrderService.CreateManualOrderAsync(new Order
            {
                ClientName = model.ClientName.Trim(),
                ClientPhone = model.ClientPhone,
                GarmentType = garment,
                MixedGarmentDetails = mixedJson,
                GiftOption = model.GiftOption,
                Sport = sport,
                Quantity = quantity,
                Notes = model.Notes,
                Priority = model.Priority,
                ReceivedAt = model.ReceivedAt.Value.ToUniversalTime(),
                AgreedDeliveryDate = model.AgreedDeliveryDate?.ToUniversalTime()
            }, userId);

            if (!string.IsNullOrEmpty(model.DesignerId))
            {
                await OrderService.AssignDesignerAsync(order.Id, model.DesignerId, userId);
            }

            Navigation.NavigateTo($"/pedidos/{order.Id}");
        }
        catch (Exception ex)
        {
            error = ex.Message;
            isSaving = false;
        }
    }

    private sealed class CreateOrderModel
    {
        public CreateOrderModel()
        {
            MixedLines.Add(new MixedGarmentLineModel { ItemType = OrderFormOptions.MixedGarmentItemTypes[0], Quantity = 1 });
        }

        [Required(ErrorMessage = "Ingrese el nombre del cliente.")]
        public string ClientName { get; set; } = string.Empty;

        public string? ClientPhone { get; set; }

        public string GarmentType { get; set; } = "Conjunto completo";
        public string? GarmentTypeOther { get; set; }
        public List<MixedGarmentLineModel> MixedLines { get; } = [];

        public string Sport { get; set; } = "Fútbol";
        public string? SportOther { get; set; }

        [Range(1, 10000, ErrorMessage = "Cantidad inválida.")]
        public int Quantity { get; set; } = 1;

        public string? Notes { get; set; }
        public OrderPriority Priority { get; set; } = OrderPriority.Normal;
        public DateTime? AgreedDeliveryDate { get; set; } = DateTime.Today.AddDays(7);
        public DateTime? ReceivedAt { get; set; } = DateTime.Today;
        public GiftOption GiftOption { get; set; } = GiftOption.None;
        public string? DesignerId { get; set; }
    }

    private sealed class MixedGarmentLineModel
    {
        public string ItemType { get; set; } = string.Empty;
        public int Quantity { get; set; } = 1;
        public string? OtherDescription { get; set; }
    }
}
