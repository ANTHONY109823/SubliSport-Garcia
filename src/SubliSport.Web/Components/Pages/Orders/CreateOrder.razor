@using SubliSport.Domain.Enums
@using SubliSport.Domain.Landing
@using SubliSport.Domain.Orders
@using SubliSport.Web.Components.Shared
@using SubliSport.Web.Services

@page "/pedidos/nuevo"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

<PageTitle>Nuevo pedido - SUBLISPORT GARCIA</PageTitle>

<div class="page-header-row">
    <h1 class="page-title page-title-compact">Registrar pedido</h1>
    <div class="circle-pick-row quote-priority-top">
        @foreach (var p in OrderFormOptions.PriorityQuick)
        {
            var priority = p.Value;
            <button type="button"
                    class="circle-pick @PriorityToneClass(priority) @(model.Priority == priority ? "active" : "")"
                    @onclick="() => SelectPriority(priority)">
                <span class="circle-pick-ring">@PriorityIcon(priority)</span>
                <span class="circle-pick-label">@p.Label</span>
            </button>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert-success">@message</div>
}
@if (!string.IsNullOrEmpty(error))
{
    <div class="alert-error">@error</div>
}

<EditForm Model="model" FormName="createOrderForm" id="createOrderForm" OnValidSubmit="HandleSubmit" class="form-panel form-quote-admin form-quote-ultra">
    <DataAnnotationsValidator />

    <div class="quote-ultra-block">
        <ClientTypeSelector CircleStyle="true" SelectedTier="model.PricingTier" SelectedTierChanged="SelectPricingTier" />
        @if (model.PricingTier == ClientPricingTier.MypeB2B)
        {
            <div class="circle-pick-row circle-pick-row-spaced">
                @foreach (var opt in ServiceTypeHelper.Options)
                {
                    var serviceKey = opt.Key;
                    var isActive = IsMypeServiceSelected(serviceKey);
                    <button type="button"
                            class="circle-pick @ServiceToneClass(serviceKey) @(isActive ? "active" : "")"
                            @onclick="() => ToggleMypeService(serviceKey)">
                        <span class="circle-pick-ring">@opt.Icon</span>
                        <span class="circle-pick-label">@ShortServiceLabel(serviceKey)</span>
                    </button>
                }
            </div>
        }
    </div>

    <div class="quote-ultra-block quote-ultra-fields">
        <div class="form-group form-group-xs">
            <label>Cliente *</label>
            <InputText @bind-value="model.ClientName" class="form-control form-control-xs" placeholder="Club o nombre" />
            <ValidationMessage For="() => model.ClientName" />
        </div>
        <div class="form-group form-group-xs">
            <label>WhatsApp *</label>
            <InputText @bind-value="model.ClientPhone" class="form-control form-control-xs" placeholder="999 999 999" />
        </div>
    </div>

    <div class="quote-ultra-block">
        <div class="circle-pick-row">
            @foreach (var g in OrderFormOptions.GarmentChips)
            {
                var value = g.Value;
                <button type="button"
                        class="circle-pick @(model.GarmentType == value ? "active" : "")"
                        @onclick="() => SelectGarment(value)">
                    <span class="circle-pick-ring">@GarmentIcon(value)</span>
                    <span class="circle-pick-label">@ShortGarmentLabel(g.Label)</span>
                </button>
            }
        </div>
        @if (GarmentTypeHelper.IsMixed(model.GarmentType))
        {
            <div class="mixed-inline">
                @for (var i = 0; i < model.MixedLines.Count; i++)
                {
                    var line = model.MixedLines[i];
                    var index = i;
                    <div class="mixed-inline-row">
                        <select @bind="line.ItemType" class="form-control form-control-xs">
                            @foreach (var itemType in OrderFormOptions.MixedGarmentItemTypes)
                            {
                                <option value="@itemType">@itemType</option>
                            }
                        </select>
                        @if (line.ItemType == "Otro")
                        {
                            <input type="text" @bind="line.OtherDescription" class="form-control form-control-xs" placeholder="Otro" />
                        }
                        <input type="number" min="1" @bind="line.Quantity" class="form-control form-control-xs mixed-qty-xs" />
                        @if (model.MixedLines.Count > 1)
                        {
                            <button type="button" class="chip-remove-xs" @onclick="() => RemoveMixedLine(index)">✕</button>
                        }
                    </div>
                }
                <button type="button" class="chip-add-xs" @onclick="AddMixedLine">+ línea</button>
            </div>
        }
    </div>

    <div class="quote-ultra-block quote-ultra-fields form-grid-ultra">
        @if (!GarmentTypeHelper.IsMixed(model.GarmentType))
        {
            <div class="form-group form-group-xs">
                <label>Cant. *</label>
                <InputNumber @bind-value="model.Quantity" class="form-control form-control-xs" />
                <ValidationMessage For="() => model.Quantity" />
            </div>
        }
        <div class="form-group form-group-xs">
            <label>Tela</label>
            <InputSelect @bind-value="model.FabricKey" class="form-control form-control-xs">
                @foreach (var fabric in OrderFormOptions.Fabrics)
                {
                    <option value="@fabric.Key">@fabric.Label</option>
                }
            </InputSelect>
        </div>
        <div class="form-group form-group-xs">
            <label>Tallas</label>
            <InputSelect @bind-value="model.SizeRangeSummary" class="form-control form-control-xs">
                <option value="">—</option>
                @foreach (var size in OrderFormOptions.SizeRanges)
                {
                    <option value="@size.Value">@size.Label</option>
                }
            </InputSelect>
        </div>
        <div class="form-group form-group-xs">
            <label>Ingreso *</label>
            <InputDate @bind-value="model.ReceivedAt" class="form-control form-control-xs" />
        </div>
        <div class="form-group form-group-xs">
            <label>Entrega *</label>
            <div class="date-inline">
                <InputDate @bind-value="model.AgreedDeliveryDate" class="form-control form-control-xs" />
                <button type="button" class="chip-add-xs" @onclick="ApplySuggestedDelivery" title="7 días hábiles">+7d</button>
            </div>
        </div>
    </div>

    <div class="quote-ultra-block">
        <span class="quote-ultra-kicker">Bordado</span>
        <div class="circle-pick-row">
            <button type="button" class="circle-pick @(model.EmbroideryEscudo ? "active" : "")" @onclick="ToggleEmbroideryEscudo">
                <span class="circle-pick-ring">🎯</span>
                <span class="circle-pick-label">Logo</span>
            </button>
            <button type="button" class="circle-pick @(model.EmbroideryMarca ? "active" : "")" @onclick="ToggleEmbroideryMarca">
                <span class="circle-pick-ring">🏷️</span>
                <span class="circle-pick-label">Marca</span>
            </button>
            <button type="button" class="circle-pick @(model.EmbroideryShort ? "active" : "")" @onclick="ToggleEmbroideryShort">
                <span class="circle-pick-ring">🩳</span>
                <span class="circle-pick-label">Short</span>
            </button>
        </div>
    </div>

    <div class="quote-ultra-block">
        <AdminQuoteRosterEditor Rows="model.RosterRows" Compact="true" />
    </div>

    <div class="quote-ultra-block quote-ultra-photos-block">
        <span class="quote-ultra-kicker">Fotos de referencia</span>
        <AdminQuotePhotoSlots Slots="model.PhotoSlots" Compact="true" />
    </div>

    <div class="quote-ultra-block quote-ultra-footer">
        <div class="circle-pick-row">
            @foreach (var gift in GiftOptionHelper.Options)
            {
                var giftValue = gift.Value;
                <button type="button"
                        class="circle-pick @(model.GiftOption == giftValue ? "active" : "")"
                        @onclick="() => SelectGift(giftValue)">
                    <span class="circle-pick-ring">@GiftIcon(giftValue)</span>
                    <span class="circle-pick-label">@ShortGiftLabel(gift.Label)</span>
                </button>
            }
        </div>
        <span class="quote-ultra-kicker">Diseñador</span>
        <DesignerPickerCards Designers="designers" Workloads="designerWorkloads" DetailedMetrics="true" @bind-SelectedDesignerId="model.DesignerId" />
    </div>

    <div class="form-actions-sticky form-actions-compact">
        <button type="submit" class="btn-primary btn-primary-sm" disabled="@isSaving">
            @(isSaving ? "Guardando..." : "Registrar pedido")
        </button>
        <a href="/pedidos" class="btn-secondary btn-secondary-sm">Cancelar</a>
    </div>
</EditForm>

@code {
    [Inject] private OrderService OrderService { get; set; } = default!;
    [Inject] private QuoteReferenceImageService QuoteImages { get; set; } = default!;
    [Inject] private PanelUiConfigurationService PanelUiConfig { get; set; } = default!;
    [Inject] private UserManagementService UserManagementService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private readonly CreateOrderModel model = new();
    private PanelUiSettingsData ui = PanelUiSettingsData.CreateDefault();
    private List<ApplicationUser> designers = [];
    private Dictionary<string, DesignerWorkloadInfo> designerWorkloads = new();
    private bool isSaving;
    private string? message;
    private string? error;

    private static string ShortGarmentLabel(string label) => label switch
    {
        "Conjunto completo" => "Conjunto",
        "Solo camiseta" => "Camiseta",
        "Ambos tipos" => "Mixto",
        _ => label
    };

    private static string GarmentIcon(string value) => value switch
    {
        "Conjunto completo (camiseta + short + medias)" => "🎽",
        "Solo camiseta" => "👕",
        "Mixta" => "📦",
        _ => "👕"
    };

    private static string ShortServiceLabel(string key) => key switch
    {
        ServiceTypeHelper.PrintPressOnly => "Impresión",
        ServiceTypeHelper.WithLaserCut => "Láser",
        ServiceTypeHelper.WithConfection => "Confección",
        _ => key
    };

    private static string ServiceToneClass(string key) => key switch
    {
        ServiceTypeHelper.WithLaserCut => "tone-laser",
        _ => string.Empty
    };

    private static string PriorityToneClass(OrderPriority priority) => priority switch
    {
        OrderPriority.Normal => "tone-normal",
        OrderPriority.Alta => "tone-alta",
        OrderPriority.Urgente => "tone-urgente",
        _ => string.Empty
    };

    private static string PriorityIcon(OrderPriority priority) => priority switch
    {
        OrderPriority.Normal => "✓",
        OrderPriority.Alta => "⚡",
        OrderPriority.Urgente => "🔥",
        _ => "•"
    };

    private static string GiftIcon(GiftOption gift) => gift switch
    {
        GiftOption.None => "—",
        GiftOption.Pelota => "⚽",
        GiftOption.Banderola => "🚩",
        GiftOption.CamisetaExtra => "👕",
        _ => "🎁"
    };

    private static string ShortGiftLabel(string label) => label switch
    {
        "Sin obsequio" => "Sin regalo",
        "Camiseta extra" => "+Camiseta",
        _ => label
    };

    protected override async Task OnInitializedAsync()
    {
        ui = await PanelUiConfig.GetSettingsAsync();
        designers = (await UserManagementService.GetDesignersAsync()).Where(d => d.IsActive).ToList();

        var auth = await AuthState;
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId is null) return;

        var roles = auth.User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value);
        var orders = await OrderService.GetOrdersForUserAsync(userId, roles);
        designerWorkloads = DesignerWorkloadHelper.BuildWorkloads(orders, designers.Select(d => d.Id));
        if (designers.Count > 0)
        {
            model.DesignerId = designers
                .OrderBy(d => designerWorkloads.GetValueOrDefault(d.Id)?.TotalPendientes ?? 0)
                .ThenBy(d => d.FullName)
                .First()
                .Id;
        }
        ApplySuggestedDelivery();
    }

    private void SelectGarment(string value)
    {
        model.GarmentType = value;
        StateHasChanged();
    }

    private Task SelectPricingTier(ClientPricingTier tier)
    {
        model.PricingTier = tier;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private bool IsMypeServiceSelected(string key) => key switch
    {
        ServiceTypeHelper.PrintPressOnly => model.MypePrintPress,
        ServiceTypeHelper.WithLaserCut => model.MypeLaserCut,
        ServiceTypeHelper.WithConfection => model.MypeConfection,
        _ => false
    };

    private void ToggleMypeService(string key)
    {
        switch (key)
        {
            case ServiceTypeHelper.PrintPressOnly:
                model.MypePrintPress = !model.MypePrintPress;
                break;
            case ServiceTypeHelper.WithLaserCut:
                model.MypeLaserCut = !model.MypeLaserCut;
                break;
            case ServiceTypeHelper.WithConfection:
                model.MypeConfection = !model.MypeConfection;
                break;
        }

        StateHasChanged();
    }

    private void SelectGift(GiftOption value)
    {
        model.GiftOption = value;
        StateHasChanged();
    }

    private void SelectPriority(OrderPriority value)
    {
        model.Priority = value;
        StateHasChanged();
    }

    private void ToggleEmbroideryEscudo() { model.EmbroideryEscudo = !model.EmbroideryEscudo; StateHasChanged(); }
    private void ToggleEmbroideryMarca() { model.EmbroideryMarca = !model.EmbroideryMarca; StateHasChanged(); }
    private void ToggleEmbroideryShort() { model.EmbroideryShort = !model.EmbroideryShort; StateHasChanged(); }

    private void ApplySuggestedDelivery()
    {
        var today = DateTime.Today;
        model.AgreedDeliveryDate = AddBusinessDays(today, 7);
        StateHasChanged();
    }

    private static DateTime AddBusinessDays(DateTime from, int days)
    {
        var d = from;
        var added = 0;
        while (added < days)
        {
            d = d.AddDays(1);
            if (d.DayOfWeek is not DayOfWeek.Saturday and not DayOfWeek.Sunday)
            {
                added++;
            }
        }
        return d;
    }

    private void AddMixedLine() =>
        model.MixedLines.Add(new MixedGarmentLineModel { ItemType = OrderFormOptions.MixedGarmentItemTypes[0], Quantity = 1 });

    private void RemoveMixedLine(int index)
    {
        if (model.MixedLines.Count > 1)
        {
            model.MixedLines.RemoveAt(index);
        }
    }

    private LandingQuoteSubmitRequest BuildQuoteRequest()
    {
        var sport = OrderFormOptions.DefaultSport;
        var garment = GarmentTypeHelper.IsMixed(model.GarmentType) ? "Mixta" : model.GarmentType;

        var roster = model.RosterRows
            .Where(r => !string.IsNullOrWhiteSpace(r.Name) || !string.IsNullOrWhiteSpace(r.Size) || !string.IsNullOrWhiteSpace(r.Number))
            .Select(r => new LandingQuoteRosterLine
            {
                Name = r.Name.Trim(),
                Size = r.Size.Trim(),
                Number = r.Number.Trim(),
                Gender = RosterGenderHelper.Normalize(r.Gender)
            })
            .ToList();

        var mixed = model.MixedLines
            .Where(l => l.Quantity > 0 && !string.IsNullOrWhiteSpace(l.ItemType))
            .Select(l => new LandingQuoteMixedLine
            {
                ItemType = l.ItemType,
                Quantity = l.Quantity,
                OtherDescription = l.ItemType == "Otro" ? l.OtherDescription : null
            })
            .ToList();

        var qty = GarmentTypeHelper.IsMixed(model.GarmentType)
            ? mixed.Sum(l => l.Quantity)
            : roster.Count > 0 ? roster.Count : model.Quantity;

        return new LandingQuoteSubmitRequest
        {
            ClientName = model.ClientName.Trim(),
            ClientPhone = model.ClientPhone?.Trim(),
            GarmentType = garment,
            Sport = sport,
            Quantity = Math.Max(1, qty),
            SizeRangeSummary = model.SizeRangeSummary,
            Notes = model.Notes,
            DesiredDeliveryDeadline = model.AgreedDeliveryDate?.ToString("dd/MM/yyyy"),
            Roster = roster,
            MixedLines = mixed,
            ReferenceImagesBase64 = model.PhotoSlots.Where(p => !string.IsNullOrWhiteSpace(p.Base64)).Select(p => p.Base64!).ToList(),
            FabricKey = model.FabricKey,
            EmbroideryEscudo = model.EmbroideryEscudo,
            EmbroideryMarca = model.EmbroideryMarca,
            EmbroideryShort = model.EmbroideryShort
        };
    }

    private async Task HandleSubmit()
    {
        isSaving = true;
        error = null;
        message = null;

        var auth = await AuthState;
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId is null)
        {
            error = "Sesión inválida.";
            isSaving = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(model.ClientPhone))
        {
            error = "Indique el WhatsApp del cliente.";
            isSaving = false;
            return;
        }

        if (GarmentTypeHelper.IsMixed(model.GarmentType) &&
            !model.MixedLines.Any(l => l.Quantity > 0 && !string.IsNullOrWhiteSpace(l.ItemType)))
        {
            error = "Agregue al menos una línea al pedido mixto.";
            isSaving = false;
            return;
        }

        if (model.ReceivedAt is null || model.AgreedDeliveryDate is null)
        {
            error = "Indique fecha de ingreso y de entrega.";
            isSaving = false;
            return;
        }

        try
        {
            var request = BuildQuoteRequest();
            var quote = LandingQuoteCalculator.Calculate(request);
            var imageUrls = await QuoteImages.SaveAsync(request.ReferenceImagesBase64);

            var order = LandingQuoteOrderAssembler.Build(
                request,
                quote,
                imageUrls,
                model.ReceivedAt.Value,
                model.AgreedDeliveryDate.Value.ToUniversalTime(),
                model.Priority,
                model.GiftOption);

            order.PricingTier = model.PricingTier;
            if (model.PricingTier == ClientPricingTier.MypeB2B)
            {
                if (!ServiceTypeHelper.HasAnyService(model.MypePrintPress, model.MypeLaserCut, model.MypeConfection))
                {
                    error = "Seleccione al menos un paso de servicio (impresión, láser o confección).";
                    isSaving = false;
                    return;
                }

                order.ChargeAmount = 0;
                order.CalculatedTotal = 0;
                order.PricingNotes = null;
                ServiceTypeHelper.ApplyServiceFlags(order, model.MypePrintPress, model.MypeLaserCut, model.MypeConfection);
            }

            var created = await OrderService.CreateManualOrderAsync(
                order,
                userId,
                "Pedido registrado manualmente por admin (formulario cotización)");

            if (!string.IsNullOrEmpty(model.DesignerId))
            {
                await OrderService.AssignDesignerAsync(created.Id, model.DesignerId, userId);
            }

            Navigation.NavigateTo($"/pedidos/{created.Id}");
        }
        catch (Exception ex)
        {
            error = ex.Message;
            isSaving = false;
        }
    }

    private sealed class CreateOrderModel
    {
        public CreateOrderModel()
        {
            MixedLines.Add(new MixedGarmentLineModel { ItemType = OrderFormOptions.MixedGarmentItemTypes[0], Quantity = 1 });
            RosterRows.Add(new AdminQuoteRosterEditor.RosterRowModel());
            for (var i = 0; i < 3; i++)
            {
                PhotoSlots.Add(new AdminQuotePhotoSlots.PhotoSlotModel());
            }
        }

        [Required(ErrorMessage = "Ingrese el nombre del cliente.")]
        public string ClientName { get; set; } = string.Empty;

        public string? ClientPhone { get; set; }
        public string GarmentType { get; set; } = OrderFormOptions.GarmentChips[0].Value;
        public List<MixedGarmentLineModel> MixedLines { get; } = [];
        public string Sport { get; set; } = OrderFormOptions.DefaultSport;

        [Range(1, 10000, ErrorMessage = "Cantidad inválida.")]
        public int Quantity { get; set; } = 1;

        public string FabricKey { get; set; } = "dry_fit";
        public string? SizeRangeSummary { get; set; }
        public string? Notes { get; set; }
        public bool EmbroideryEscudo { get; set; }
        public bool EmbroideryMarca { get; set; }
        public bool EmbroideryShort { get; set; }
        public OrderPriority Priority { get; set; } = OrderPriority.Normal;
        public DateTime? AgreedDeliveryDate { get; set; }
        public DateTime? ReceivedAt { get; set; } = DateTime.Today;
        public GiftOption GiftOption { get; set; } = GiftOption.None;
        public ClientPricingTier PricingTier { get; set; } = ClientPricingTier.DirectRetail;
        public bool MypePrintPress { get; set; } = true;
        public bool MypeLaserCut { get; set; }
        public bool MypeConfection { get; set; }
        public string? DesignerId { get; set; }
        public List<AdminQuoteRosterEditor.RosterRowModel> RosterRows { get; } = [];
        public List<AdminQuotePhotoSlots.PhotoSlotModel> PhotoSlots { get; } = [];
    }

    private sealed class MixedGarmentLineModel
    {
        public string ItemType { get; set; } = string.Empty;
        public int Quantity { get; set; } = 1;
        public string? OtherDescription { get; set; }
    }
}
