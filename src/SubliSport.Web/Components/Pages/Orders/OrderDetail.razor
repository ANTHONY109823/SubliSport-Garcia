@page "/pedidos/{OrderId:guid}"
@layout AdminLayout
@attribute [Authorize(Roles = "SuperAdmin,Admin,Designer")]
@rendermode InteractiveServer

<PageTitle>Detalle pedido - SUBLISPORT GARCIA</PageTitle>

@if (order is null)
{
    <p class="empty-state">Pedido no encontrado.</p>
}
else
{
    <div class="detail-header">
        <div>
            <h1 class="page-title">@order.OrderNumber</h1>
            <p class="page-subtitle">@order.ClientName · @OrderStatusHelper.GetLabel(order.Status)</p>
        </div>
        <a href="/pedidos" class="btn-outline">← Volver</a>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert-success">@message</div>
    }
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert-error">@error</div>
    }

    <div class="detail-grid">
        <section class="panel-section">
            <h2>Datos del pedido</h2>
            <dl class="detail-list">
                <div><dt>Prenda</dt><dd>@order.GarmentType</dd></div>
                <div><dt>Deporte</dt><dd>@order.Sport</dd></div>
                <div><dt>Cantidad</dt><dd>@order.Quantity</dd></div>
                <div><dt>Tallas</dt><dd>@(order.SizeRange ?? "—")</dd></div>
                <div><dt>Prioridad</dt><dd>@OrderStatusHelper.GetPriorityLabel(order.Priority)</dd></div>
                <div><dt>Entrega acordada</dt><dd>@(order.AgreedDeliveryDate?.ToString("dd/MM/yyyy") ?? "—")</dd></div>
                <div><dt>Notas</dt><dd>@(order.Notes ?? "—")</dd></div>
            </dl>
        </section>

        <AuthorizeView Roles="SuperAdmin,Admin">
            <section class="panel-section">
                <h2>Asignar diseñador</h2>
                <div class="form-inline">
                    <select @bind="selectedDesignerId" class="form-control">
                        <option value="">Seleccionar diseñador...</option>
                        @foreach (var designer in designers)
                        {
                            <option value="@designer.Id">@designer.FullName</option>
                        }
                    </select>
                    <button class="btn-primary" @onclick="AssignDesigner" disabled="@string.IsNullOrEmpty(selectedDesignerId)">Asignar</button>
                </div>
            </section>
        </AuthorizeView>

        <AuthorizeView Roles="SuperAdmin,Admin,Designer">
            <section class="panel-section">
                <h2>Actualizar estado</h2>
                <div class="form-inline">
                    <select @bind="selectedStatus" class="form-control">
                        @foreach (var status in Enum.GetValues<OrderStatus>())
                        {
                            <option value="@status">@OrderStatusHelper.GetLabel(status)</option>
                        }
                    </select>
                    <InputText @bind-value="statusComment" placeholder="Comentario opcional" class="form-control" />
                    <button class="btn-primary" @onclick="UpdateStatus">Actualizar</button>
                </div>
            </section>
        </AuthorizeView>

        <section class="panel-section">
            <h2>Historial</h2>
            @if (order.StatusHistory.Count == 0)
            {
                <p class="empty-state">Sin movimientos registrados.</p>
            }
            else
            {
                <ul class="history-list">
                    @foreach (var item in order.StatusHistory)
                    {
                        <li>
                            <strong>@item.ChangedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong>
                            — @OrderStatusHelper.GetLabel(item.FromStatus) → @OrderStatusHelper.GetLabel(item.ToStatus)
                            @if (!string.IsNullOrWhiteSpace(item.Comment))
                            {
                                <span> · @item.Comment</span>
                            }
                        </li>
                    }
                </ul>
            }
        </section>
    </div>
}

@code {
    [Parameter] public Guid OrderId { get; set; }

    [Inject] private OrderService OrderService { get; set; } = default!;
    [Inject] private UserManagementService UserManagementService { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private Order? order;
    private List<ApplicationUser> designers = [];
    private string? selectedDesignerId;
    private OrderStatus selectedStatus;
    private string? statusComment;
    private string? message;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        order = await OrderService.GetByIdAsync(OrderId);
        if (order is null) return;

        selectedStatus = order.Status;
        selectedDesignerId = order.AssignedDesignerId;
        designers = await UserManagementService.GetDesignersAsync();
    }

    private async Task AssignDesigner()
    {
        if (order is null || string.IsNullOrEmpty(selectedDesignerId)) return;

        var auth = await AuthState;
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId is null) return;

        try
        {
            await OrderService.AssignDesignerAsync(order.Id, selectedDesignerId, userId);
            order = await OrderService.GetByIdAsync(OrderId);
            message = "Diseñador asignado correctamente.";
            error = null;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task UpdateStatus()
    {
        if (order is null) return;

        var auth = await AuthState;
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId is null) return;

        try
        {
            await OrderService.UpdateStatusAsync(order.Id, selectedStatus, userId, statusComment);
            order = await OrderService.GetByIdAsync(OrderId);
            message = "Estado actualizado.";
            error = null;
            statusComment = null;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}
