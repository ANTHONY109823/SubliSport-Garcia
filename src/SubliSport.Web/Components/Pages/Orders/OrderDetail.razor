@page "/pedidos/{OrderId:guid}"
@using SubliSport.Domain.Enums
@layout AdminLayout
@attribute [Authorize(Roles = "Admin,Designer")]
@rendermode InteractiveServer

<PageTitle>Detalle pedido - SUBLISPORT GARCIA</PageTitle>

@if (order is null)
{
    <p class="empty-state">Pedido no encontrado.</p>
}
else
{
    <div class="detail-header">
        <div>
            <h1 class="page-title">@order.OrderNumber</h1>
            <p class="page-subtitle">
                @order.ClientName
                · <span class="badge status-@order.Status.ToString().ToLower()">@OrderDisplayHelper.GetStatusLabel(order)</span>
                · <span class="badge priority-@order.Priority.ToString().ToLower()">@OrderStatusHelper.GetPriorityLabel(order.Priority)</span>
            </p>
        </div>
        <a href="/pedidos" class="btn-outline">← Volver</a>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert-success">@message</div>
    }
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert-error">@error</div>
    }

    <div class="detail-grid detail-grid-2">
        <section class="panel-section">
            <h2>Datos del pedido</h2>
            <dl class="detail-list">
                @{
                    var panelKey = isDesignerView ? UiPanelKeys.DesignerOrderDetail : UiPanelKeys.AdminOrderDetail;
                }
                @if (UiLabelHelper.IsVisible(ui, panelKey, "clientName"))
                {
                    <div><dt>@UiLabelHelper.Label(ui, panelKey, "clientName", "Cliente")</dt><dd>@order.ClientName</dd></div>
                }
                @if (UiLabelHelper.IsVisible(ui, panelKey, "clientPhone"))
                {
                    <div>
                        <dt>@UiLabelHelper.Label(ui, panelKey, "clientPhone", "WhatsApp")</dt>
                        <dd>
                            @if (whatsappUrl is not null)
                            {
                                <a href="@whatsappUrl" target="_blank" rel="noopener noreferrer" class="whatsapp-link">
                                    📱 @WhatsAppHelper.FormatDisplayPhone(order.ClientPhone)
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">Sin número registrado</span>
                            }
                        </dd>
                    </div>
                }
                @if (UiLabelHelper.IsVisible(ui, panelKey, "garmentType"))
                {
                    <div><dt>@UiLabelHelper.Label(ui, panelKey, "garmentType", "Prenda")</dt><dd>@OrderDisplayHelper.GetGarmentDisplay(order)</dd></div>
                }
                @if (GarmentTypeHelper.IsMixed(order.GarmentType))
                {
                    <div>
                        <dt>Detalle mixto</dt>
                        <dd>
                            <ul class="mixed-summary-list">
                                @foreach (var line in MixedGarmentHelper.Parse(order.MixedGarmentDetails))
                                {
                                    <li>@MixedGarmentHelper.FormatLine(line)</li>
                                }
                            </ul>
                        </dd>
                    </div>
                }
                @if (order.GiftOption != GiftOption.None)
                {
                    <div><dt>Obsequio</dt><dd>@GiftOptionHelper.GetLabel(order.GiftOption)</dd></div>
                }
                @if (UiLabelHelper.IsVisible(ui, panelKey, "sport"))
                {
                    <div><dt>@UiLabelHelper.Label(ui, panelKey, "sport", "Deporte")</dt><dd>@order.Sport</dd></div>
                }
                @if (UiLabelHelper.IsVisible(ui, panelKey, "quantity"))
                {
                    <div><dt>@UiLabelHelper.Label(ui, panelKey, "quantity", "Cantidad")</dt><dd>@order.Quantity uds.</dd></div>
                }
                @if (UiLabelHelper.IsVisible(ui, panelKey, "sizeRange"))
                {
                    <div><dt>@UiLabelHelper.Label(ui, panelKey, "sizeRange", "Tallas")</dt><dd class="@(string.IsNullOrWhiteSpace(order.SizeRange) ? "text-muted" : "")">@(string.IsNullOrWhiteSpace(order.SizeRange) ? "Pendiente" : order.SizeRange)</dd></div>
                }
                @if (!isDesignerView && UiLabelHelper.IsVisible(ui, panelKey, "receivedAt"))
                {
                    <div><dt>@UiLabelHelper.Label(ui, panelKey, "receivedAt", "Fecha de ingreso de pedido")</dt><dd>@order.ReceivedAt.ToLocalTime().ToString("dd/MM/yyyy")</dd></div>
                }
                @if (UiLabelHelper.IsVisible(ui, panelKey, "agreedDeliveryDate"))
                {
                    <div><dt>@UiLabelHelper.Label(ui, panelKey, "agreedDeliveryDate", "Fecha de entrega de pedido")</dt><dd>@(order.AgreedDeliveryDate?.ToLocalTime().ToString("dd/MM/yyyy") ?? "—")</dd></div>
                }
                @if (!isDesignerView && order.FabricMeters is > 0)
                {
                    <div><dt>Metraje diseñador</dt><dd>@OrderDisplayHelper.FormatFabricMeters(order)</dd></div>
                }
                @if (UiLabelHelper.IsVisible(ui, panelKey, "notes"))
                {
                    var notesSplit = ReferenceImageNotesHelper.Split(order.Notes);
                    <div><dt>@UiLabelHelper.Label(ui, panelKey, "notes", "Notas admin")</dt><dd>@(string.IsNullOrWhiteSpace(notesSplit.TextNotes) ? "—" : notesSplit.TextNotes)</dd></div>
                    @if (notesSplit.ImageUrls.Count > 0)
                    {
                        <div>
                            <dt>Fotos referencia del cliente</dt>
                            <dd><OrderReferencePhotos ImageUrls="notesSplit.ImageUrls" /></dd>
                        </div>
                    }
                }
                @if (!isDesignerView && UiLabelHelper.IsVisible(ui, panelKey, "assignedDesigner"))
                {
                    <div><dt>@UiLabelHelper.Label(ui, panelKey, "assignedDesigner", "Diseñador")</dt><dd>@(order.AssignedDesigner?.FullName ?? "Sin asignar")</dd></div>
                }
            </dl>
        </section>

        @if (!isDesignerView)
        {
            <section class="panel-section panel-highlight">
                <h2>Recorrido por áreas</h2>
                <p class="field-hint">Área, fecha y tiempo entre etapas.</p>
                <OrderTimeline Order="order" />
            </section>

            <section class="panel-section panel-section-compact">
                <h2>Asignar diseñador</h2>
                <p class="field-hint">Asigne al diseñador con menos pendientes.</p>
                <DesignerPickerCards Designers="designers"
                                     Workloads="designerWorkloads"
                                     CurrentDesignerId="order.AssignedDesignerId"
                                     @bind-SelectedDesignerId="selectedDesignerId" />
                <div class="form-actions">
                    <button type="button" class="btn-primary" @onclick="AssignDesigner" disabled="@(isBusy || string.IsNullOrEmpty(selectedDesignerId) || selectedDesignerId == order.AssignedDesignerId)">
                        @(order.AssignedDesignerId is null ? "Asignar diseñador" : "Reasignar")
                    </button>
                </div>
            </section>

            @if (ShowProformaPanel())
            {
                <section class="panel-section panel-highlight">
                    <h2>Proforma y cotización</h2>
                    <p class="field-hint">
                        @if (isLandingQuote)
                        {
                            <span>Cotización recibida desde <strong>cotizar.html</strong>. Revise, ajuste el precio y envíe la proforma al cliente.</span>
                        }
                        else
                        {
                            <span>Arme la proforma con los datos del pedido, guarde y descárguela en PDF o envíela por WhatsApp.</span>
                        }
                        @if (order.FabricTypeName is not null)
                        {
                            <span> · Tela: <strong>@order.FabricTypeName</strong></span>
                        }
                    </p>

                    @if (!string.IsNullOrWhiteSpace(internalSuggestion))
                    {
                        <h3 class="panel-subtitle">Sugerencia interna (no enviar al cliente)</h3>
                        <pre class="proforma-preview proforma-internal">@internalSuggestion</pre>
                    }

                    <div class="form-group">
                        <label>Precio a cobrar al cliente (S/) *</label>
                        <input type="number" step="0.01" min="0" @bind="editChargeAmount" class="form-control" style="max-width:220px;" />
                    </div>

                    <div class="form-group">
                        <label>Mensaje para WhatsApp (editable)</label>
                        <p class="field-hint">El PDF usa el formato de boleta automático. Este texto es el resumen que se envía por WhatsApp.</p>
                        <textarea @bind="editClientProforma" class="form-control proforma-editor" rows="12"></textarea>
                    </div>

                    <div class="form-actions">
                        <button type="button" class="btn-secondary" disabled="@isBusy" @onclick="RegenerateProformaDraft">
                            Regenerar borrador
                        </button>
                        <button type="button" class="btn-primary" disabled="@isBusy" @onclick="SaveLandingProformaAsync">
                            Guardar proforma
                        </button>
                        <a href="/pedidos/@order.Id/proforma" target="_blank" class="btn-outline">
                            📄 Descargar PDF
                        </a>
                        @if (clientProformaWhatsAppUrl is not null)
                        {
                            <a href="@clientProformaWhatsAppUrl" target="_blank" rel="noopener noreferrer" class="btn-action btn-success">
                                📲 Enviar proforma por WhatsApp
                            </a>
                        }
                    </div>
                    @if (clientProformaWhatsAppUrl is null)
                    {
                        <p class="field-hint text-muted">Registre el WhatsApp del cliente para habilitar el envío.</p>
                    }
                </section>
            }

            @if (ProduccionOrderHelper.CanMarkDelivered(order))
            {
                <section class="panel-section panel-highlight">
                    <h2>Entrega al cliente</h2>
                    <p class="field-hint">El pedido está listo para recoger. Regístrelo cuando el cliente lo retire.</p>
                    <button type="button" class="btn-action btn-success btn-action-lg" disabled="@isBusy" @onclick="MarkDeliveredAsync">
                        ✓ Registrar entrega al cliente
                    </button>
                </section>
            }
        }

        @if (isDesignerView && !isOwnDesignOrder)
        {
            <section class="panel-section">
                <p class="field-hint">Este pedido no está asignado a usted. Solo puede consultar la información general.</p>
            </section>
        }
        else if (isDesignerView && isOwnDesignOrder)
        {
                @if (DesignerOrderHelper.IsPending(order) || DesignerOrderHelper.IsDesignPhaseComplete(order))
                {
                    <section class="panel-section">
                        <h2>Detalles técnicos (diseño)</h2>
                        @if (DesignerOrderHelper.IsPending(order))
                        {
                            <div class="form-group">
                                <label>Tallas / medidas</label>
                                <InputText @bind-value="editSizeRange" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label>Notas de diseño</label>
                                <InputTextArea @bind-value="editNotes" class="form-control" rows="3" />
                            </div>
                            @if (referenceImageUrls.Count > 0)
                            {
                                <div class="form-group">
                                    <label>Fotos referencia del cliente</label>
                                    <OrderReferencePhotos ImageUrls="referenceImageUrls" />
                                </div>
                            }
                            <button type="button" class="btn-secondary" @onclick="SaveDesignerDetails">Guardar detalles</button>
                        }
                        else
                        {
                            <dl class="detail-list">
                                <div><dt>Tallas / medidas</dt><dd>@(string.IsNullOrWhiteSpace(order.SizeRange) ? "—" : order.SizeRange)</dd></div>
                                @{
                                    var designNotesSplit = ReferenceImageNotesHelper.Split(order.Notes);
                                }
                                <div><dt>Notas de diseño</dt><dd>@(string.IsNullOrWhiteSpace(designNotesSplit.TextNotes) ? "—" : designNotesSplit.TextNotes)</dd></div>
                                @if (designNotesSplit.ImageUrls.Count > 0)
                                {
                                    <div>
                                        <dt>Fotos referencia del cliente</dt>
                                        <dd><OrderReferencePhotos ImageUrls="designNotesSplit.ImageUrls" /></dd>
                                    </div>
                                }
                                @if (order.FabricMeters.HasValue)
                                {
                                    <div><dt>Metraje tela</dt><dd>@order.FabricMeters.Value.ToString("N2") m</dd></div>
                                }
                                @if (order.FabricMetersRip.HasValue && order.FabricMetersRip > 0)
                                {
                                    <div><dt>Metraje RIP</dt><dd>@order.FabricMetersRip.Value.ToString("N2") m</dd></div>
                                }
                            </dl>
                        }
                    </section>
                }

                <section class="panel-section panel-highlight">
                    <h2>Acciones de diseño</h2>
                    <div class="designer-actions">
                        @if (DesignerOrderHelper.CanAccept(order))
                        {
                            <button type="button" class="btn-action btn-success btn-action-lg" @onclick="AcceptOrder">✓ Aceptar pedido</button>
                        }
                        @if (DesignerOrderHelper.CanStart(order))
                        {
                            <button type="button" class="btn-action btn-edit btn-action-lg" @onclick="StartOrder">▶ Iniciar pedido</button>
                        }
                        @if (DesignerOrderHelper.CanMarkPendingClientApproval(order))
                        {
                            <button type="button" class="btn-action btn-warn btn-action-lg" @onclick="MarkPendingClientAsync">⏳ PENDIENTE DE APROBACIÓN</button>
                        }
                        @if (DesignerOrderHelper.CanResumeAfterClient(order))
                        {
                            <button type="button" class="btn-action btn-edit btn-action-lg" @onclick="ResumeAfterClientAsync">▶ Cliente respondió — continuar</button>
                        }
                        @if (DesignerOrderHelper.CanFinish(order))
                        {
                            <div class="return-box production-meters-box">
                                <h3>Metraje para producción</h3>
                                <p class="field-hint">Indique el metraje de tela antes de enviar el pedido a producción.</p>
                                <div class="form-group">
                                    <label>Metraje tela (m) *</label>
                                    <input type="number" step="0.01" min="0.01" @bind="finishFabricMeters" class="form-control" />
                                </div>
                                <label class="checkbox-row">
                                    <input type="checkbox" @bind="finishHasRip" />
                                    Incluye RIP
                                </label>
                                @if (finishHasRip)
                                {
                                    <div class="form-group">
                                        <label>Metraje RIP (m) *</label>
                                        <input type="number" step="0.01" min="0.01" @bind="finishFabricMetersRip" class="form-control" />
                                    </div>
                                }
                                <button type="button" class="btn-action btn-primary-action btn-action-lg" disabled="@isBusy" @onclick="FinishDesign">
                                    ✔ Diseño finalizado — enviar a producción
                                </button>
                            </div>
                        }
                        @if (DesignerOrderHelper.CanReturn(order))
                        {
                            <div class="return-box">
                                <label>Motivo de devolución</label>
                                <InputTextArea @bind-value="returnComment" class="form-control" rows="2" />
                                <button type="button" class="btn-action btn-warn" @onclick="ReturnOrder" disabled="@string.IsNullOrWhiteSpace(returnComment)">↩ Devolver</button>
                            </div>
                        }
                    </div>
                </section>
        }

        @if (isDesignerView)
        {
            <section class="panel-section">
                <h2>Recorrido por áreas</h2>
                <OrderTimeline Order="order" />
            </section>
        }
    </div>
}

@code {
    [Parameter] public Guid OrderId { get; set; }

    [Inject] private OrderService OrderService { get; set; } = default!;
    [Inject] private PanelUiConfigurationService PanelUiConfig { get; set; } = default!;
    [Inject] private UserManagementService UserManagementService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private PanelUiSettingsData ui = PanelUiSettingsData.CreateDefault();
    private Order? order;
    private bool isBusy;
    private List<ApplicationUser> designers = [];
    private Dictionary<string, DesignerWorkloadInfo> designerWorkloads = new();
    private string? selectedDesignerId;
    private string? currentUserId;
    private bool isDesignerView;
    private bool isOwnDesignOrder;
    private string? whatsappUrl;
    private string? clientProformaWhatsAppUrl;
    private string? internalSuggestion;
    private bool isLandingQuote;
    private string editClientProforma = string.Empty;
    private decimal editChargeAmount;
    private string? editSizeRange;
    private string? editNotes;
    private List<string> referenceImageUrls = [];
    private string? returnComment;
    private decimal finishFabricMeters;
    private decimal finishFabricMetersRip;
    private bool finishHasRip;
    private string? message;
    private string? error;

    protected override async Task OnInitializedAsync() => await LoadOrderAsync();

    private async Task LoadOrderAsync()
    {
        ui = await PanelUiConfig.GetSettingsAsync();
        order = await OrderService.GetByIdAsync(OrderId);
        if (order is null) return;

        selectedDesignerId = order.AssignedDesignerId;
        editSizeRange = order.SizeRange;
        var notesSplit = ReferenceImageNotesHelper.Split(order.Notes);
        editNotes = notesSplit.TextNotes;
        referenceImageUrls = notesSplit.ImageUrls;
        finishFabricMeters = order.FabricMeters ?? 0;
        finishFabricMetersRip = order.FabricMetersRip ?? 0;
        finishHasRip = order.FabricMetersRip is > 0 || order.FabricTypeRipId.HasValue;
        whatsappUrl = WhatsAppHelper.BuildChatUrl(order.ClientPhone, WhatsAppHelper.BuildOrderMessage(order.ClientName, order.OrderNumber));

        var auth = await AuthState;
        currentUserId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (currentUserId is null) return;

        var roles = auth.User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();
        isDesignerView = roles.Contains(AppRoles.Designer) && !roles.Contains(AppRoles.Admin);
        isOwnDesignOrder = order.AssignedDesignerId == currentUserId;

        isLandingQuote = LandingQuoteNotesHelper.IsLandingQuote(order.PricingNotes);
        internalSuggestion = LandingQuoteNotesHelper.GetInternalSuggestion(order.PricingNotes);
        editClientProforma = LandingQuoteNotesHelper.GetClientProforma(order.PricingNotes);
        editChargeAmount = order.ChargeAmount > 0 ? order.ChargeAmount : order.CalculatedTotal;
        if (string.IsNullOrWhiteSpace(editClientProforma) && ShowProformaPanel())
        {
            editClientProforma = OrderProformaBuilder.BuildClientDraft(order, editChargeAmount);
        }

        clientProformaWhatsAppUrl = BuildClientProformaWhatsAppUrl();

        if (roles.Contains(AppRoles.Admin))
        {
            designers = (await UserManagementService.GetDesignersAsync()).Where(d => d.IsActive).ToList();
            var allOrders = await OrderService.GetOrdersForUserAsync(currentUserId, roles);
            designerWorkloads = DesignerWorkloadHelper.BuildWorkloads(
                allOrders,
                designers.Select(d => d.Id));

            if (order.AssignedDesignerId is null && designers.Count > 0)
            {
                selectedDesignerId = designers
                    .OrderBy(d => designerWorkloads.GetValueOrDefault(d.Id)?.TotalPendientes ?? 0)
                    .ThenBy(d => d.FullName)
                    .First()
                    .Id;
            }
        }
    }

    private bool ShowProformaPanel() =>
        order is not null &&
        !isDesignerView &&
        order.Status is not OrderStatus.Entregado and not OrderStatus.Cancelado;

    private void RegenerateProformaDraft()
    {
        if (order is null) return;
        editClientProforma = OrderProformaBuilder.BuildClientDraft(order, editChargeAmount);
        clientProformaWhatsAppUrl = BuildClientProformaWhatsAppUrl();
        message = "Borrador de proforma actualizado con los datos del pedido.";
        error = null;
    }

    private string? BuildClientProformaWhatsAppUrl()
    {
        if (order is null || string.IsNullOrWhiteSpace(order.ClientPhone) || string.IsNullOrWhiteSpace(editClientProforma))
        {
            return null;
        }

        return WhatsAppHelper.BuildChatUrl(
            order.ClientPhone,
            WhatsAppHelper.TruncateForWhatsApp(WhatsAppHelper.BuildLandingProformaMessage(editClientProforma)));
    }

    private async Task SaveLandingProformaAsync()
    {
        if (order is null || currentUserId is null) return;
        if (editChargeAmount <= 0)
        {
            error = "Indique el precio a cobrar al cliente.";
            return;
        }
        if (string.IsNullOrWhiteSpace(editClientProforma))
        {
            error = "La proforma para el cliente no puede estar vacía.";
            return;
        }

        try
        {
            isBusy = true;
            await OrderService.SaveLandingQuoteProformaAsync(
                order.Id,
                currentUserId,
                editChargeAmount,
                editClientProforma.Trim());
            await LoadOrderAsync();
            message = "Proforma guardada. Ya puede descargar el PDF o enviarla por WhatsApp.";
            error = null;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task AssignDesigner()
    {
        if (order is null || string.IsNullOrEmpty(selectedDesignerId) || currentUserId is null) return;
        try
        {
            await OrderService.AssignDesignerAsync(order.Id, selectedDesignerId, currentUserId);
            await LoadOrderAsync();
            message = "Diseñador asignado correctamente.";
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task SaveDesignerDetails()
    {
        if (order is null || currentUserId is null) return;
        try
        {
            await OrderService.DesignerUpdateDetailsAsync(
                order.Id,
                currentUserId,
                editSizeRange,
                ReferenceImageNotesHelper.Merge(editNotes, referenceImageUrls));
            await LoadOrderAsync();
            message = "Detalles guardados.";
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task AcceptOrder()
    {
        if (order is null || currentUserId is null) return;
        try
        {
            await OrderService.DesignerAcceptAsync(order.Id, currentUserId);
            await LoadOrderAsync();
            message = "Pedido aceptado.";
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task StartOrder()
    {
        if (order is null || currentUserId is null) return;
        try
        {
            await OrderService.DesignerStartAsync(order.Id, currentUserId);
            await LoadOrderAsync();
            message = "Trabajo iniciado.";
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task FinishDesign()
    {
        if (order is null || currentUserId is null || isBusy) return;
        if (finishFabricMeters <= 0)
        {
            error = "Indique el metraje de la tela antes de enviar a producción.";
            return;
        }

        if (finishHasRip && finishFabricMetersRip <= 0)
        {
            error = "Indique el metraje RIP.";
            return;
        }

        isBusy = true;
        error = null;
        message = null;
        try
        {
            await OrderService.DesignerFinishAsync(
                order.Id,
                currentUserId,
                finishFabricMeters,
                finishHasRip,
                finishHasRip ? finishFabricMetersRip : null);
            await LoadOrderAsync();
            message = "Diseño finalizado. El pedido fue enviado a producción.";
        }
        catch (Exception ex) { error = ex.Message; }
        finally
        {
            isBusy = false;
        }
    }

    private async Task MarkPendingClientAsync()
    {
        if (order is null || currentUserId is null) return;
        try
        {
            await OrderService.DesignerMarkPendingClientApprovalAsync(order.Id, currentUserId);
            await LoadOrderAsync();
            message = "Marcado como PENDIENTE DE APROBACIÓN.";
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task ResumeAfterClientAsync()
    {
        if (order is null || currentUserId is null) return;
        try
        {
            await OrderService.DesignerResumeAfterClientAsync(order.Id, currentUserId);
            await LoadOrderAsync();
            message = "Cliente respondió. Puede continuar el diseño.";
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task ReturnOrder()
    {
        if (order is null || currentUserId is null) return;
        try
        {
            await OrderService.DesignerReturnAsync(order.Id, currentUserId, returnComment ?? "");
            Navigation.NavigateTo("/pedidos");
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task MarkDeliveredAsync()
    {
        if (order is null || currentUserId is null || isBusy) return;
        isBusy = true;
        error = null;
        message = null;
        try
        {
            await OrderService.MarkDeliveredAsync(order.Id, currentUserId);
            await LoadOrderAsync();
            message = "Pedido registrado como entregado.";
        }
        catch (Exception ex) { error = ex.Message; }
        finally
        {
            isBusy = false;
        }
    }
}
