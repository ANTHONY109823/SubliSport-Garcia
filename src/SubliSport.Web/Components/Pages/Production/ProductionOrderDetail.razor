@page "/produccion/{OrderId:guid}"
@page "/impresion/{OrderId:guid}"
@layout AdminLayout
@attribute [Authorize(Roles = "Production")]
@rendermode InteractiveServer

<PageTitle>Producción pedido - SUBLISPORT GARCIA</PageTitle>

@if (order is null)
{
    <p class="empty-state">Pedido no encontrado.</p>
}
else
{
    <div class="detail-header">
        <div>
            <h1 class="page-title">@order.OrderNumber</h1>
            <p class="page-subtitle">
                @order.ClientName
                · <span class="badge stage-badge">@ProduccionOrderHelper.GetStageLabel(order)</span>
                · <span class="badge priority-@order.Priority.ToString().ToLower()">@OrderStatusHelper.GetPriorityLabel(order.Priority)</span>
            </p>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap">
            <a href="/produccion" class="btn-outline">← Cola activa</a>
            @if (ProduccionOrderHelper.IsCompleted(order))
            {
                <a href="/produccion/historial" class="btn-outline">Historial</a>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert-success">@message</div>
    }
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert-error">@error</div>
    }

    <div class="detail-grid detail-grid-2">
        <section class="panel-section">
            <h2>Datos del pedido</h2>
            <dl class="detail-list">
                @if (UiLabelHelper.IsVisible(ui, UiPanelKeys.ProductionOrderDetail, "clientName"))
                {
                    <div><dt>@UiLabelHelper.Label(ui, UiPanelKeys.ProductionOrderDetail, "clientName", "Cliente")</dt><dd>@order.ClientName</dd></div>
                }
                @if (UiLabelHelper.IsVisible(ui, UiPanelKeys.ProductionOrderDetail, "clientPhone"))
                {
                    <div>
                        <dt>@UiLabelHelper.Label(ui, UiPanelKeys.ProductionOrderDetail, "clientPhone", "WhatsApp cliente")</dt>
                        <dd>
                            @if (clientWhatsAppUrl is not null)
                            {
                                <a href="@clientWhatsAppUrl" target="_blank" rel="noopener noreferrer" class="whatsapp-link">
                                    📱 @WhatsAppHelper.FormatDisplayPhone(order.ClientPhone)
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">Sin número</span>
                            }
                        </dd>
                    </div>
                }
                @if (UiLabelHelper.IsVisible(ui, UiPanelKeys.ProductionOrderDetail, "garmentType"))
                {
                    <div><dt>@UiLabelHelper.Label(ui, UiPanelKeys.ProductionOrderDetail, "garmentType", "Prenda")</dt><dd>@order.GarmentType@if (UiLabelHelper.IsVisible(ui, UiPanelKeys.ProductionOrderDetail, "sport")){<text> · @order.Sport</text>}</dd></div>
                }
                else if (UiLabelHelper.IsVisible(ui, UiPanelKeys.ProductionOrderDetail, "sport"))
                {
                    <div><dt>@UiLabelHelper.Label(ui, UiPanelKeys.ProductionOrderDetail, "sport", "Deporte")</dt><dd>@order.Sport</dd></div>
                }
                @if (UiLabelHelper.IsVisible(ui, UiPanelKeys.ProductionOrderDetail, "quantity"))
                {
                    <div><dt>@UiLabelHelper.Label(ui, UiPanelKeys.ProductionOrderDetail, "quantity", "Cantidad")</dt><dd>@order.Quantity uds.</dd></div>
                }
                @if (UiLabelHelper.IsVisible(ui, UiPanelKeys.ProductionOrderDetail, "sizeRange"))
                {
                    <div><dt>@UiLabelHelper.Label(ui, UiPanelKeys.ProductionOrderDetail, "sizeRange", "Tallas")</dt><dd>@(order.SizeRange ?? "—")</dd></div>
                }
                @if (UiLabelHelper.IsVisible(ui, UiPanelKeys.ProductionOrderDetail, "agreedDeliveryDate"))
                {
                    <div><dt>@UiLabelHelper.Label(ui, UiPanelKeys.ProductionOrderDetail, "agreedDeliveryDate", "Entrega")</dt><dd>@(order.AgreedDeliveryDate?.ToString("dd/MM/yyyy") ?? "—")</dd></div>
                }
                @if (UiLabelHelper.IsVisible(ui, UiPanelKeys.ProductionOrderDetail, "assignedDesigner"))
                {
                    <div><dt>@UiLabelHelper.Label(ui, UiPanelKeys.ProductionOrderDetail, "assignedDesigner", "Diseñador")</dt><dd>@(order.AssignedDesigner?.FullName ?? "—")</dd></div>
                }
                @if (UiLabelHelper.IsVisible(ui, UiPanelKeys.ProductionOrderDetail, "notes"))
                {
                    <div><dt>@UiLabelHelper.Label(ui, UiPanelKeys.ProductionOrderDetail, "notes", "Notas")</dt><dd>@(order.Notes ?? "—")</dd></div>
                }
            </dl>
        </section>

        @if (canDoProductionActions)
        {
            <section class="panel-section panel-highlight">
                <h2>Acciones de producción</h2>
                <p class="field-hint">Avance paso a paso: Impresión → Planchado → Confección (si aplica). Solo un botón activo a la vez.</p>

                <div class="designer-actions production-steps">
                    @if (ProduccionOrderHelper.CanAccept(order))
                    {
                        <form method="post" action="/produccion/pedidos/@OrderId/aceptar" class="inline-form accept-form">
                            <button type="submit" class="btn-action btn-success btn-action-lg">✓ Aceptar pedido</button>
                        </form>
                    }

                    @if (ProduccionOrderHelper.IsAccepted(order) || order.Status is OrderStatus.EnImpresion or OrderStatus.EnPlanchado or OrderStatus.EnConfeccion or OrderStatus.ListoEntrega)
                    {
                        <div class="production-step @(ProduccionOrderHelper.IsImpresionComplete(order) ? "step-done" : "step-active")">
                            <h3>1. Impresión</h3>
                            @if (ProduccionOrderHelper.CanStartImpresion(order))
                            {
                                <button type="button" class="btn-action btn-edit" disabled="@isBusy" @onclick="StartImpresionAsync">▶ Iniciar impresión</button>
                            }
                            else if (ProduccionOrderHelper.CanFinishImpresion(order))
                            {
                                <button type="button" class="btn-action btn-primary-action" disabled="@isBusy" @onclick="FinishImpresionAsync">✔ Finalizar impresión</button>
                            }
                            else if (ProduccionOrderHelper.IsImpresionComplete(order))
                            {
                                <span class="step-status">✓ Impresión completada</span>
                            }
                        </div>

                        @if (ProduccionOrderHelper.IsImpresionComplete(order))
                        {
                            <div class="production-step @(ProduccionOrderHelper.IsPlanchadoComplete(order) ? "step-done" : "step-active")">
                                <h3>2. Planchado</h3>
                                @if (ProduccionOrderHelper.CanStartPlanchado(order))
                                {
                                    <button type="button" class="btn-action btn-edit" disabled="@isBusy" @onclick="StartPlanchadoAsync">▶ Enviar a planchado</button>
                                }
                                else if (ProduccionOrderHelper.CanFinishPlanchado(order))
                                {
                                    <button type="button" class="btn-action btn-primary-action" disabled="@isBusy" @onclick="FinishPlanchadoAsync">✔ Finalizar planchado</button>
                                }
                                else if (ProduccionOrderHelper.IsPlanchadoComplete(order))
                                {
                                    <span class="step-status">✓ Planchado completado</span>
                                }
                            </div>
                        }

                        @if (ProduccionOrderHelper.RequiresConfection(order) && ProduccionOrderHelper.IsPlanchadoComplete(order))
                        {
                            <div class="production-step @(ProduccionOrderHelper.GetEffectiveSubStage(order) == ProductionSubStage.ConfeccionListo ? "step-done" : "step-active")">
                                <h3>3. Confección</h3>
                                @if (ProduccionOrderHelper.CanStartConfeccion(order))
                                {
                                    <button type="button" class="btn-action btn-edit" disabled="@isBusy" @onclick="StartConfeccionAsync">▶ Iniciar confección</button>
                                }
                                else if (ProduccionOrderHelper.CanFinishConfeccion(order))
                                {
                                    <button type="button" class="btn-action btn-primary-action" disabled="@isBusy" @onclick="FinishConfeccionAsync">✔ Finalizar confección</button>
                                }
                                else if (ProduccionOrderHelper.GetEffectiveSubStage(order) == ProductionSubStage.ConfeccionListo)
                                {
                                    <span class="step-status">✓ Confección completada</span>
                                }
                            </div>
                        }

                        @if (ProduccionOrderHelper.CanMarkReadyForPickup(order))
                        {
                            <div class="production-step step-final">
                                <button type="button" class="btn-action btn-success btn-action-lg" disabled="@isBusy" @onclick="MarkReadyAsync">
                                    ✔ Finalizar producción — pedido listo para entrega
                                </button>
                            </div>
                        }

                        @if (ProduccionOrderHelper.CanMarkDelivered(order))
                        {
                            <div class="production-step step-final">
                                <div class="alert-success inline-alert" style="margin-bottom:12px">Pedido listo. El cliente puede recogerlo.</div>
                                <button type="button" class="btn-action btn-success btn-action-lg" disabled="@isBusy" @onclick="MarkDeliveredAsync">
                                    ✓ Registrar entrega al cliente
                                </button>
                            </div>
                        }
                    }

                    @if (order.Status == OrderStatus.Entregado)
                    {
                        <div class="alert-success inline-alert">Pedido entregado @(order.DeliveredAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "").</div>
                    }
                </div>
            </section>
        }

        @if (canDoProductionActions && !ProduccionOrderHelper.IsCompleted(order))
        {
            <OrderPricingCalculator Order="order" OnSaved="ReloadAsync" ReadOnly="false" />
        }
        else if (order.ChargeAmount > 0 || order.CalculatedTotal > 0)
        {
            <OrderPricingCalculator Order="order" ReadOnly="true" />
        }

        <section class="panel-section">
            <h2>Recorrido del pedido</h2>
            <OrderTimeline Order="order" />
        </section>
    </div>
}

@code {
    [Parameter] public Guid OrderId { get; set; }

    [Inject] private OrderService OrderService { get; set; } = default!;
    [Inject] private PanelUiConfigurationService PanelUiConfig { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private PanelUiSettingsData ui = PanelUiSettingsData.CreateDefault();
    private Order? order;
    private string? clientWhatsAppUrl;
    private bool canDoProductionActions;
    private bool isBusy;
    private string? message;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        ui = await PanelUiConfig.GetSettingsAsync();
        ReadQueryMessages();
        await ReloadAsync();
    }

    private void ReadQueryMessages()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("msg", out var msg) && msg == "accepted")
        {
            message = "Pedido aceptado. Puede iniciar producción.";
        }

        if (query.TryGetValue("error", out var err) && !string.IsNullOrWhiteSpace(err))
        {
            error = err.ToString();
        }
    }

    private async Task ReloadAsync()
    {
        order = await OrderService.GetByIdAsync(OrderId);
        if (order is null) return;

        clientWhatsAppUrl = WhatsAppHelper.BuildChatUrl(
            order.ClientPhone,
            WhatsAppHelper.BuildOrderMessage(order.ClientName, order.OrderNumber));

        var auth = await AuthState;
        var roles = auth.User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();
        canDoProductionActions = roles.Contains(AppRoles.Production);
    }

    private async Task RunAction(Func<Task> action, string success)
    {
        if (isBusy) return;

        error = null;
        message = null;
        isBusy = true;
        try
        {
            await action();
            await ReloadAsync();
            message = success;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isBusy = false;
            StateHasChanged();
        }
    }

    private async Task StartImpresionAsync() => await RunAction(async () =>
    {
        await OrderService.ProduccionStartImpresionAsync(OrderId, await GetUserIdAsync());
    }, "Impresión iniciada.");

    private async Task FinishImpresionAsync() => await RunAction(async () =>
    {
        await OrderService.ProduccionFinishImpresionAsync(OrderId, await GetUserIdAsync());
    }, "Impresión finalizada. Puede enviar a planchado.");

    private async Task StartPlanchadoAsync() => await RunAction(async () =>
    {
        await OrderService.ProduccionStartPlanchadoAsync(OrderId, await GetUserIdAsync());
    }, "Planchado iniciado.");

    private async Task FinishPlanchadoAsync() => await RunAction(async () =>
    {
        await OrderService.ProduccionFinishPlanchadoAsync(OrderId, await GetUserIdAsync());
    }, ProduccionOrderHelper.RequiresConfection(order!)
        ? "Planchado finalizado. Puede iniciar confección."
        : "Planchado finalizado. Puede marcar listo para entrega.");

    private async Task StartConfeccionAsync() => await RunAction(async () =>
    {
        await OrderService.ProduccionStartConfeccionAsync(OrderId, await GetUserIdAsync());
    }, "Confección iniciada.");

    private async Task FinishConfeccionAsync() => await RunAction(async () =>
    {
        await OrderService.ProduccionFinishConfeccionAsync(OrderId, await GetUserIdAsync());
    }, "Confección finalizada. Puede marcar listo para entrega.");

    private async Task MarkReadyAsync() => await RunAction(async () =>
    {
        await OrderService.ProduccionMarkReadyForPickupAsync(OrderId, await GetUserIdAsync());
    }, "Pedido listo para entrega.");

    private async Task MarkDeliveredAsync() => await RunAction(async () =>
    {
        await OrderService.MarkDeliveredAsync(OrderId, await GetUserIdAsync());
    }, "Pedido registrado como entregado.");

    private async Task<string> GetUserIdAsync()
    {
        var auth = await AuthState;
        return auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
               ?? throw new InvalidOperationException("Sesión inválida.");
    }
}
