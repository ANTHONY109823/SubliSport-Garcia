@page "/produccion/{OrderId:guid}"
@page "/impresion/{OrderId:guid}"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin,Production")]
@rendermode InteractiveServer

<PageTitle>Producción pedido - SUBLISPORT GARCIA</PageTitle>

@if (order is null)
{
    <p class="empty-state">Pedido no encontrado.</p>
}
else
{
    <div class="detail-header">
        <div>
            <h1 class="page-title">@order.OrderNumber</h1>
            <p class="page-subtitle">
                @order.ClientName
                · <span class="badge stage-badge">@ProduccionOrderHelper.GetStageLabel(order)</span>
                · <span class="badge priority-@order.Priority.ToString().ToLower()">@OrderStatusHelper.GetPriorityLabel(order.Priority)</span>
            </p>
        </div>
        <a href="/produccion" class="btn-outline">← Volver</a>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert-success">@message</div>
    }
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert-error">@error</div>
    }

    <div class="detail-grid detail-grid-2">
        <section class="panel-section">
            <h2>Datos del pedido</h2>
            <dl class="detail-list">
                <div><dt>Cliente</dt><dd>@order.ClientName</dd></div>
                <div>
                    <dt>WhatsApp cliente</dt>
                    <dd>
                        @if (clientWhatsAppUrl is not null)
                        {
                            <a href="@clientWhatsAppUrl" target="_blank" rel="noopener noreferrer" class="whatsapp-link">
                                📱 @WhatsAppHelper.FormatDisplayPhone(order.ClientPhone)
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">Sin número</span>
                        }
                    </dd>
                </div>
                <div><dt>Prenda</dt><dd>@order.GarmentType · @order.Sport</dd></div>
                <div><dt>Cantidad</dt><dd>@order.Quantity uds.</dd></div>
                <div><dt>Tallas</dt><dd>@(order.SizeRange ?? "—")</dd></div>
                <div><dt>Entrega</dt><dd>@(order.AgreedDeliveryDate?.ToString("dd/MM/yyyy") ?? "—")</dd></div>
                <div><dt>Diseñador</dt><dd>@(order.AssignedDesigner?.FullName ?? "—")</dd></div>
                <div><dt>Notas</dt><dd>@(order.Notes ?? "—")</dd></div>
            </dl>
        </section>

        @if (canDoProductionActions)
        {
            <section class="panel-section panel-highlight">
                <h2>Acciones de producción</h2>
                <p class="field-hint">Producción se desglosa en: Impresión → Planchado → Confección (si aplica). Cada movimiento queda con fecha y hora.</p>

                <div class="designer-actions">
                    @if (ProduccionOrderHelper.CanAccept(order))
                    {
                        <button type="button" class="btn-action btn-success btn-action-lg" disabled="@isBusy" @onclick="AcceptOrderAsync">
                            @(isBusy ? "Guardando…" : "✓ Aceptar pedido")
                        </button>
                    }
                    @if (ProduccionOrderHelper.CanStart(order))
                    {
                        <button type="button" class="btn-action btn-edit btn-action-lg" disabled="@isBusy" @onclick="StartOrderAsync">▶ Iniciar producción</button>
                    }

                    @if (order.Status is OrderStatus.EnImpresion or OrderStatus.EnPlanchado or OrderStatus.EnConfeccion
                         || (order.Status == OrderStatus.DisenoAprobado && ProduccionOrderHelper.IsAccepted(order)))
                    {
                        <div class="stage-buttons">
                            <span class="field-hint">Etapa actual:</span>
                            <button type="button" class="btn-action @(order.Status == OrderStatus.EnImpresion ? "btn-primary-action" : "")" disabled="@isBusy" @onclick="() => SetStageAsync(OrderStatus.EnImpresion)">🖨 Impresión</button>
                            <button type="button" class="btn-action @(order.Status == OrderStatus.EnPlanchado ? "btn-primary-action" : "")" disabled="@isBusy" @onclick="() => SetStageAsync(OrderStatus.EnPlanchado)">🔥 Planchado</button>
                            @if (order.IncludesConfection && !order.ServiceOnlyPrintPress)
                            {
                                <button type="button" class="btn-action @(order.Status == OrderStatus.EnConfeccion ? "btn-primary-action" : "")" disabled="@isBusy" @onclick="() => SetStageAsync(OrderStatus.EnConfeccion)">✂️ Confección</button>
                            }
                        </div>
                    }

                    @if (ProduccionOrderHelper.CanMarkReadyForPickup(order))
                    {
                        <button type="button" class="btn-action btn-primary-action btn-action-lg" disabled="@isBusy" @onclick="MarkReadyAsync">
                            ✔ Trabajo finalizado — pendiente por recoger
                        </button>
                    }

                    @if (order.Status == OrderStatus.ListoEntrega)
                    {
                        <div class="alert-success inline-alert">Pedido listo. El cliente puede recogerlo.</div>
                    }
                </div>
            </section>

            <section class="panel-section @(ProduccionOrderHelper.IsAccepted(order) ? "panel-highlight" : "")">
                <h2>Archivo para imprimir (WhatsApp)</h2>
                @if (ProduccionOrderHelper.IsAccepted(order))
                {
                    <p class="field-hint">Los archivos se envían al grupo de WhatsApp de producción. Abra el grupo para ver el mensaje con el archivo del diseñador.</p>
                    <div class="whatsapp-actions">
                        @if (productionGroupWhatsAppUrl is not null)
                        {
                            <a href="@productionGroupWhatsAppUrl" target="_blank" rel="noopener noreferrer" class="whatsapp-link btn-action btn-success btn-action-lg">
                                📲 @(string.IsNullOrWhiteSpace(productionGroupName) ? "Grupo WhatsApp producción" : productionGroupName)
                            </a>
                        }
                        else
                        {
                            <p class="text-muted">Grupo WhatsApp no configurado. El SuperAdmin debe agregar el enlace en Configuración.</p>
                        }

                        @if (designerWhatsAppUrl is not null)
                        {
                            <a href="@designerWhatsAppUrl" target="_blank" rel="noopener noreferrer" class="whatsapp-link btn-action btn-edit">
                                📱 Chat con diseñador (@WhatsAppHelper.FormatDisplayPhone(order.AssignedDesigner?.PhoneNumber))
                            </a>
                        }
                    </div>
                }
                else
                {
                    <p class="field-hint">Acepte el pedido para habilitar el acceso al archivo en WhatsApp.</p>
                }
            </section>
        }

        @if ((canDoProductionActions || isAdminView) && !ProduccionOrderHelper.IsCompleted(order))
        {
            <OrderPricingCalculator Order="order" OnSaved="ReloadAsync" ReadOnly="@isAdminView" />
        }
        else if (order.ChargeAmount > 0 || order.CalculatedTotal > 0)
        {
            <OrderPricingCalculator Order="order" ReadOnly="true" />
        }

        <section class="panel-section">
            <h2>Historial (con hora)</h2>
            @if (order.StatusHistory.Count == 0)
            {
                <p class="empty-state">Sin movimientos.</p>
            }
            else
            {
                <ul class="history-list history-timeline">
                    @foreach (var item in order.StatusHistory.OrderByDescending(h => h.ChangedAt))
                    {
                        <li>
                            <time datetime="@item.ChangedAt.ToString("O")">
                                @item.ChangedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
                            </time>
                            @if (item.FromStatus != item.ToStatus)
                            {
                                <span> — @OrderStatusHelper.GetLabel(item.FromStatus) → @OrderStatusHelper.GetLabel(item.ToStatus)</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Comment))
                            {
                                <span> · @item.Comment</span>
                            }
                        </li>
                    }
                </ul>
            }
        </section>
    </div>
}

@code {
    [Parameter] public Guid OrderId { get; set; }

    [Inject] private OrderService OrderService { get; set; } = default!;
    [Inject] private ProductionConfigurationService ProductionConfig { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private Order? order;
    private string? clientWhatsAppUrl;
    private string? designerWhatsAppUrl;
    private string? productionGroupWhatsAppUrl;
    private string? productionGroupName;
    private bool canDoProductionActions;
    private bool isAdminView;
    private bool isBusy;
    private string? message;
    private string? error;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        order = await OrderService.GetByIdAsync(OrderId);
        if (order is null) return;

        clientWhatsAppUrl = WhatsAppHelper.BuildChatUrl(
            order.ClientPhone,
            WhatsAppHelper.BuildOrderMessage(order.ClientName, order.OrderNumber));

        var designerPhone = order.AssignedDesigner?.PhoneNumber;
        var fileMessage = WhatsAppHelper.BuildProductionFileMessage(
            order.OrderNumber,
            order.ClientName,
            order.AssignedDesigner?.FullName);

        designerWhatsAppUrl = WhatsAppHelper.BuildChatUrl(designerPhone, fileMessage);

        var productionSettings = await ProductionConfig.GetSettingsAsync();
        productionGroupName = productionSettings.GroupName;
        productionGroupWhatsAppUrl = WhatsAppHelper.ResolveProductionGroupUrl(
            productionSettings.GroupInviteUrl,
            productionSettings.FallbackPhone,
            fileMessage);

        var auth = await AuthState;
        var roles = auth.User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();
        canDoProductionActions = roles.Contains(AppRoles.Production);
        isAdminView = roles.Contains(AppRoles.Admin) && !canDoProductionActions;
    }

    private async Task RunAction(Func<Task> action, string success)
    {
        if (isBusy) return;

        error = null;
        message = null;
        isBusy = true;
        try
        {
            await action();
            await ReloadAsync();
            message = success;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isBusy = false;
            StateHasChanged();
        }
    }

    private async Task AcceptOrderAsync()
    {
        await RunAction(async () =>
        {
            var userId = await GetUserIdAsync();
            await OrderService.ProduccionAcceptAsync(OrderId, userId);
        }, "Pedido aceptado. Abra WhatsApp para ver el archivo del diseñador.");
    }

    private async Task StartOrderAsync()
    {
        await RunAction(async () =>
        {
            var userId = await GetUserIdAsync();
            await OrderService.ProduccionStartAsync(OrderId, userId);
        }, "Producción iniciada.");
    }

    private async Task SetStageAsync(OrderStatus stage)
    {
        await RunAction(async () =>
        {
            var userId = await GetUserIdAsync();
            await OrderService.ProduccionSetStageAsync(OrderId, stage, userId);
        }, $"Etapa: {OrderStatusHelper.GetLabel(stage)}.");
    }

    private async Task MarkReadyAsync()
    {
        await RunAction(async () =>
        {
            var userId = await GetUserIdAsync();
            await OrderService.ProduccionMarkReadyForPickupAsync(OrderId, userId);
        }, "Marcado como pendiente por recoger.");
    }

    private async Task<string> GetUserIdAsync()
    {
        var auth = await AuthState;
        return auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
               ?? throw new InvalidOperationException("Sesión inválida.");
    }
}
