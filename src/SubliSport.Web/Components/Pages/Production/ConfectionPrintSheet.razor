@page "/produccion/{OrderId:guid}/ficha-confeccion"
@layout PrintLayout
@attribute [Authorize(Roles = "Production,Admin")]
@rendermode InteractiveServer

@if (order is null)
{
    <p>Pedido no encontrado.</p>
}
else if (!ProduccionOrderHelper.CanPrintWorkSheet(order))
{
    <p class="empty-state">Este pedido aún no está verificado en diseño. Imprima la ficha cuando el diseñador lo envíe a producción.</p>
    <a href="/produccion/@OrderId" class="btn-outline no-print">← Volver al pedido</a>
}
else
{
    <div class="confection-sheet">
        <div class="print-toolbar no-print">
            <button type="button" class="btn-primary" onclick="window.print()">🖨 Imprimir hoja</button>
            <a href="/produccion/@OrderId" class="btn-outline">← Volver al pedido</a>
        </div>

        <header class="confection-sheet-header confection-brand-header">
            <div>
                <h1>Sublisport Garcia</h1>
                <p>Hoja de trabajo — impresión y confección</p>
            </div>
            <div class="confection-sheet-ref">
                <strong>@order.OrderNumber</strong>
                <p>@DateTime.Now.ToString("dd/MM/yyyy")</p>
            </div>
        </header>

        <p class="confection-summary-compact">
            <span><strong>Cliente:</strong> @order.ClientName</span>
            <span><strong>Prenda:</strong> @OrderDisplayHelper.GetGarmentDisplay(order)</span>
            <span><strong>Metraje:</strong> @FormatMeters()</span>
            <span><strong>Cantidad:</strong> @order.Quantity uds.</span>
            <span><strong>Entrega:</strong> @(order.AgreedDeliveryDate?.ToLocalTime().ToString("dd/MM/yyyy") ?? "—")</span>
            <span><strong>Diseñador:</strong> @(order.AssignedDesigner?.FullName ?? "—")</span>
        </p>

        @if (referenceImages.Count > 0)
        {
            <section class="confection-design-section">
                <h2>Diseño / referencia del cliente</h2>
                <div class="confection-design-grid">
                    @foreach (var (url, index) in referenceImages.Select((u, i) => (u, i)))
                    {
                        <figure class="confection-design-item">
                            <img src="@url" alt="Referencia @(index + 1)" />
                            <figcaption>Ref. @(index + 1)</figcaption>
                        </figure>
                    }
                </div>
            </section>
        }

        <h2 class="confection-section-title">Lista del pedido</h2>
        <p class="confection-sheet-hint">Marque con lapicero el cuadro cuando termine cada prenda.</p>
        @if (roster.Count == 0)
        {
            <table class="confection-roster-table confection-check-table">
                <thead>
                    <tr><th class="col-check">✓</th><th>#</th><th>Prenda</th><th>Talla</th><th>Número</th></tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Math.Max(1, order.Quantity); i++)
                    {
                        <tr>
                            <td class="col-check"><span class="manual-check-box" aria-hidden="true"></span></td>
                            <td>@(i + 1)</td>
                            <td>@OrderDisplayHelper.GetGarmentDisplay(order)</td>
                            <td>—</td>
                            <td>—</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <table class="confection-roster-table confection-check-table">
                <thead>
                    <tr><th class="col-check">✓</th><th>#</th><th>Nombre</th><th>Talla</th><th>Número</th><th>Corte</th></tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < roster.Count; i++)
                    {
                        var line = roster[i];
                        <tr>
                            <td class="col-check"><span class="manual-check-box" aria-hidden="true"></span></td>
                            <td>@(i + 1)</td>
                            <td>@line.Name</td>
                            <td>@line.Size</td>
                            <td>@line.Number</td>
                            <td>@RosterGenderHelper.GetCutLabel(line.Gender)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <section class="confection-stages-section">
            <h2 class="confection-section-title">Etapas (marcar al terminar)</h2>
            <div class="confection-stage-checks">
                <label class="confection-stage-item"><span class="manual-check-box"></span> Impresión</label>
                <label class="confection-stage-item"><span class="manual-check-box"></span> Planchado</label>
                @if (ProduccionOrderHelper.RequiresConfection(order))
                {
                    <label class="confection-stage-item"><span class="manual-check-box"></span> Confección</label>
                }
                <label class="confection-stage-item"><span class="manual-check-box"></span> Listo</label>
            </div>
        </section>
    </div>
}

@code {
    [Parameter] public Guid OrderId { get; set; }

    [Inject] private OrderService OrderService { get; set; } = default!;

    private Order? order;
    private List<SubliSport.Domain.Orders.ConfectionRosterLine> roster = [];
    private List<string> referenceImages = [];

    protected override async Task OnInitializedAsync()
    {
        order = await OrderService.GetByIdAsync(OrderId);
        if (order is null) return;

        roster = ConfectionRosterHelper.Parse(order.ConfectionRosterDetails);
        referenceImages = ReferenceImageNotesHelper.Split(order.Notes).ImageUrls;
    }

    private string FormatMeters()
    {
        if (order is null || !order.FabricMeters.HasValue || order.FabricMeters <= 0)
        {
            return "—";
        }

        if (order.ClientOwnFabric)
        {
            var text = $"Tela del cliente · {order.FabricMeters.Value:N2} m";
            if (order.FabricMetersRip is > 0)
            {
                text += $" · RIP {order.FabricMetersRip.Value:N2} m (consultar)";
            }

            return text;
        }

        var main = $"{order.FabricMeters.Value:N2} m";
        if (!string.IsNullOrWhiteSpace(order.FabricTypeName))
        {
            main += $" · {order.FabricTypeName}";
        }

        if (order.FabricMetersRip is > 0)
        {
            main += $" · RIP {order.FabricMetersRip.Value:N2} m";
            if (!string.IsNullOrWhiteSpace(order.FabricTypeRipName))
            {
                main += $" ({order.FabricTypeRipName})";
            }
        }

        return main;
    }
}
