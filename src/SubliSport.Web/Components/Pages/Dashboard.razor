@page "/dashboard"
@layout AdminLayout
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Panel - SUBLISPORT GARCIA</PageTitle>

@if (isSuperAdminSupport)
{
    <h1 class="page-title">Panel de soporte — SuperAdmin</h1>
    <p class="page-subtitle">Vista general del sistema para informes y monitoreo</p>

    @if (metrics is not null)
    {
        <MetricsDashboardView Metrics="metrics" ShowUserCounts="true" TeamSectionTitle="Usuarios por rol" />
        <section class="panel-section">
            <h2>Accesos de soporte</h2>
            <div class="quick-links">
                <a href="/usuarios" class="quick-link">Gestionar usuarios e ingresar como soporte</a>
            </div>
        </section>
    }
}
else if (isAdmin)
{
    <h1 class="page-title">Panel de administración</h1>
    <p class="page-subtitle">Resumen operativo del día</p>

    @if (adminMetrics is not null)
    {
        <p class="dashboard-insight">
            <strong>@directRetailCount</strong> pedidos cliente directo · <strong>@mypeCount</strong> MYPE/taller ·
            Cobros registrados <strong>S/ @totalBilled.ToString("N2")</strong>
        </p>
    }

    <div class="stats-rings-grid">
        <StatRing Label="Total pedidos" Value="@orders.Count.ToString()" Percent="100" />
        <StatRing Label="Sin diseñador" Value="@pendingAssignment.Count.ToString()" Percent="@RingPct(pendingAssignment.Count, orders.Count)" Color="#FFD166" />
        <StatRing Label="Urgentes" Value="@urgentOrders.Count.ToString()" Percent="@RingPct(urgentOrders.Count, orders.Count)" Color="#FF2D9A" />
        <StatRing Label="En producción" Value="@inProductionCount.ToString()" Percent="@RingPct(inProductionCount, orders.Count)" Color="#F0A500" />
        <StatRing Label="Por recoger" Value="@readyPickupCount.ToString()" Percent="@RingPct(readyPickupCount, orders.Count)" Color="#81C784" />
        <StatRing Label="Cobrado" Value="@($"S/ {totalBilled:N0}")" Percent="@RingPct((int)totalBilled, Math.Max((int)totalBilled, 1))" Color="#F0A500" SubLabel="total registrado" />
    </div>

    @if (adminMetrics is not null && statusLegend.Count > 0)
    {
        <div class="dashboard-charts-row">
            <section class="panel-section">
                <h2>Distribución por estado</h2>
                <DonutChart LegendItems="statusLegend" CenterLabel="Activos" />
            </section>
            <section class="panel-section">
                <h2>Tiempos promedio</h2>
                <div class="stats-rings-grid" style="margin:0">
                    <StatRing Label="Diseño" Value="@FormatHours(adminMetrics.AvgDesignHours)" Percent="@HoursPct(adminMetrics.AvgDesignHours)" Color="#F0A500" />
                    <StatRing Label="Producción" Value="@FormatHours(adminMetrics.AvgProductionHours)" Percent="@HoursPct(adminMetrics.AvgProductionHours)" Color="#00E5CC" />
                </div>
            </section>
        </div>
    }

    @if (pendingAssignment.Count > 0)
    {
        <section class="panel-section panel-highlight">
            <div class="section-header-row">
                <h2>Asignar diseñador (@pendingAssignment.Count)</h2>
                <a href="/pedidos/nuevo" class="quick-link">+ Nuevo pedido</a>
            </div>
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr><th>N°</th><th>Recepción</th><th>Cliente</th><th>Prenda</th><th>Entrega</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var order in pendingAssignment.Take(5))
                        {
                            <tr>
                                <td>@order.OrderNumber</td>
                                <td>@order.ReceivedAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
                                <td>@order.ClientName</td>
                                <td>@OrderDisplayHelper.GetGarmentDisplay(order)</td>
                                <td>@(order.AgreedDeliveryDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                <td><a href="/pedidos/@order.Id" class="btn-action btn-edit">Asignar</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (designerLeaderboard.Count > 0)
    {
        <section class="panel-section panel-highlight">
            <div class="section-header-row">
                <h2>Rendimiento diseñadores</h2>
                <a href="/pedidos/disenadores" class="quick-link">Ver detalle</a>
            </div>
            <DesignerLeaderboardTable Entries="designerLeaderboard" />
        </section>
    }

    @if (activeTracking.Count > 0)
    {
        <section class="panel-section panel-highlight">
            <div class="section-header-row">
                <h2>Seguimiento de pedidos (@activeTracking.Count)</h2>
                <a href="/pedidos" class="quick-link">Ver todos</a>
            </div>
            <p class="field-hint">Recorrido por horas — abra un pedido para ver el historial completo.</p>
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr><th>N°</th><th>Recepción</th><th>Cliente</th><th>Estado</th><th>Metraje</th><th>Último movimiento</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var order in activeTracking.Take(8))
                        {
                            var milestones = OrderJourneyHelper.BuildMilestones(order);
                            var last = milestones.LastOrDefault();
                            <tr>
                                <td>@order.OrderNumber</td>
                                <td>@order.ReceivedAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
                                <td>@order.ClientName</td>
                                <td>@OrderDisplayHelper.GetStatusLabel(order)</td>
                                <td>@OrderDisplayHelper.FormatFabricMeters(order)</td>
                                <td>
                                    @if (last is not null)
                                    {
                                        <span>@last.Area · @last.At.ToLocalTime().ToString("dd/MM HH:mm")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td><a href="/pedidos/@order.Id" class="btn-action btn-edit">Seguimiento</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <section class="panel-section">
        <h2>Accesos rápidos</h2>
        <div class="quick-links">
            <a href="/pedidos/nuevo" class="quick-link">+ Registrar pedido</a>
            <a href="/pedidos" class="quick-link">Seguimiento de pedidos</a>
            <a href="/pedidos/disenadores" class="quick-link">Rendimiento diseñadores</a>
        </div>
    </section>
}
else if (isDesigner)
{
    <h1 class="page-title">Panel de diseño</h1>
    <p class="page-subtitle">Sus pedidos asignados y métricas personales</p>

    @if (designerMetrics is not null)
    {
        <div class="stats-rings-grid">
            <StatRing Label="Por aceptar" Value="@designerMetrics.PendingAcceptance.ToString()" Percent="@RingPct(designerMetrics.PendingAcceptance, TotalDesignerPending(designerMetrics))" Color="#FFD166" />
            <StatRing Label="Por iniciar" Value="@designerMetrics.AcceptedNotStarted.ToString()" Percent="@RingPct(designerMetrics.AcceptedNotStarted, TotalDesignerPending(designerMetrics))" Color="#F0A500" />
            <StatRing Label="En diseño" Value="@designerMetrics.InProgress.ToString()" Percent="@RingPct(designerMetrics.InProgress, TotalDesignerPending(designerMetrics))" Color="#F0A500" />
            <StatRing Label="Culminados" Value="@designerMetrics.CompletedTotal.ToString()" Percent="@RingPct(designerMetrics.CompletedThisMonth, Math.Max(designerMetrics.CompletedTotal, 1))" Color="#81C784" SubLabel="@($"{designerMetrics.CompletedThisMonth} este mes")" />
            <StatRing Label="Urgentes" Value="@designerMetrics.UrgentPending.ToString()" Percent="@RingPct(designerMetrics.UrgentPending, TotalDesignerPending(designerMetrics))" Color="#FF2D9A" />
        </div>

        @if (designerMetrics.AvgHoursToComplete.HasValue)
        {
            <p class="page-subtitle">Tiempo promedio por diseño: <strong>@($"{designerMetrics.AvgHoursToComplete.Value:F1} h")</strong></p>
        }

        @if (designerMetrics.PendingOrders.Count > 0)
        {
            <section class="panel-section panel-highlight">
                <div class="section-header-row">
                    <h2>Pendientes de trabajo (@designerMetrics.PendingOrders.Count)</h2>
                    <a href="/pedidos" class="quick-link">Ver todos</a>
                </div>
                <div class="order-cards order-cards-compact">
                    @foreach (var order in designerMetrics.PendingOrders.Take(6))
                    {
                        var waUrl = WhatsAppHelper.BuildChatUrl(order.ClientPhone, WhatsAppHelper.BuildOrderMessage(order.ClientName, order.OrderNumber));
                        <article class="order-card @(DesignerOrderHelper.CanAccept(order) ? "card-new" : "card-active")">
                            <div class="order-card-header">
                                <strong>@order.OrderNumber</strong>
                                <span class="badge stage-badge">@DesignerOrderHelper.GetDesignerStageLabel(order)</span>
                            </div>
                            <div class="order-card-body">
                                <p>@order.ClientName · @order.GarmentType</p>
                                @if (waUrl is not null)
                                {
                                    <a href="@waUrl" target="_blank" rel="noopener noreferrer" class="whatsapp-link whatsapp-link-sm">📱 WhatsApp</a>
                                }
                            </div>
                            <a href="/pedidos/@order.Id" class="btn-action btn-edit">Abrir</a>
                        </article>
                    }
                </div>
            </section>
        }

        @if (designerMetrics.CompletedOrders.Count > 0)
        {
            <section class="panel-section">
                <h2>Últimos diseños culminados</h2>
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr><th>N°</th><th>Cliente</th><th>Prenda</th><th>Estado</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var order in designerMetrics.CompletedOrders)
                            {
                                <tr>
                                    <td>@order.OrderNumber</td>
                                    <td>@order.ClientName</td>
                                    <td>@order.GarmentType</td>
                                    <td>@DesignerOrderHelper.GetDesignerStageLabel(order)</td>
                                    <td><a href="/pedidos/@order.Id">Ver</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }

    <section class="panel-section">
        <h2>Accesos rápidos</h2>
        <div class="quick-links">
            <a href="/pedidos" class="quick-link">Ver mis diseños</a>
        </div>
    </section>
}
else if (isProduccion)
{
    <h1 class="page-title">Panel de producción</h1>
    <p class="page-subtitle">Impresión · Planchado · Confección · Cobros</p>

    <p class="dashboard-insight">Calculadora por <strong>metraje × S/ 15/m</strong> (impresión + planchado). Cliente directo se cotiza aparte en la web.</p>

    <div class="stats-rings-grid">
        <StatRing Label="Por aceptar" Value="@toAcceptImp.ToString()" Percent="@RingPct(toAcceptImp, orders.Count)" Color="#FFD166" />
        <StatRing Label="En trabajo" Value="@inProgressImp.ToString()" Percent="@RingPct(inProgressImp, orders.Count)" Color="#F0A500" />
        <StatRing Label="Por recoger" Value="@readyImp.ToString()" Percent="@RingPct(readyImp, orders.Count)" Color="#81C784" />
        <StatRing Label="Historial" Value="@historyCount.ToString()" Percent="@RingPct(historyCount, historyCount + orders.Count)" Color="#00E5CC" />
        <StatRing Label="Cobrado" Value="@($"S/ {totalChargedImp:N0}")" Percent="75" Color="#F0A500" SubLabel="historial" />
    </div>

    <section class="panel-section">
        <h2>Accesos rápidos</h2>
        <div class="quick-links">
            <a href="/produccion" class="quick-link">Cola activa</a>
            <a href="/produccion/historial" class="quick-link">Historial y boletas</a>
        </div>
    </section>
}
else
{
    <h1 class="page-title">Panel de control</h1>
    <section class="panel-section">
        <h2>Accesos rápidos</h2>
    </section>
}

@code {
    [Inject] private OrderService OrderService { get; set; } = default!;
    [Inject] private MetricsService MetricsService { get; set; } = default!;
    [Inject] private IHttpContextAccessor HttpContextAccessor { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private List<Order> orders = [];
    private List<Order> pendingAssignment = [];
    private List<Order> activeTracking = [];
    private List<Order> urgentOrders = [];
    private List<DesignerLeaderboardEntry> designerLeaderboard = [];
    private SystemMetrics? metrics;
    private SystemMetrics? adminMetrics;
    private DesignerPersonalMetrics? designerMetrics;
    private List<DonutChart.LegendItem> statusLegend = [];
    private int directRetailCount;
    private int mypeCount;
    private bool isSuperAdminSupport;
    private bool isAdmin;
    private bool isDesigner;
    private bool isProduccion;
    private int inProductionCount;
    private int readyPickupCount;
    private int toAcceptImp;
    private int inProgressImp;
    private int readyImp;
    private int historyCount;
    private decimal totalChargedImp;
    private decimal totalBilled;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState;
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId is null) return;

        var roles = auth.User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();
        isSuperAdminSupport = ImpersonationHelper.IsSuperAdminSupportMode(roles, HttpContextAccessor.HttpContext);
        isAdmin = roles.Contains(AppRoles.Admin) && !isSuperAdminSupport;
        isDesigner = roles.Contains(AppRoles.Designer) && !isAdmin && !isSuperAdminSupport;
        isProduccion = roles.Contains(AppRoles.Production) && !isAdmin && !isSuperAdminSupport;

        if (isSuperAdminSupport)
        {
            metrics = await MetricsService.GetSystemMetricsAsync();
            return;
        }

        if (isAdmin)
        {
            orders = await OrderService.GetOrdersForUserAsync(userId, roles);
            adminMetrics = await MetricsService.GetAdminMetricsAsync();
            designerLeaderboard = await MetricsService.GetDesignerLeaderboardAsync();
            directRetailCount = orders.Count(o => o.PricingTier == ClientPricingTier.DirectRetail);
            mypeCount = orders.Count(o => o.PricingTier == ClientPricingTier.MypeB2B);
            statusLegend = adminMetrics.OrdersByStatus
                .OrderByDescending(x => x.Value)
                .Take(6)
                .Select((item, i) => new DonutChart.LegendItem(item.Key, item.Value, ChartColor(i)))
                .ToList();
            activeTracking = orders
                .Where(o => o.Status is not OrderStatus.Entregado and not OrderStatus.Cancelado)
                .OrderBy(o => o.ReceivedAt)
                .ThenBy(o => o.CreatedAt)
                .ToList();
            pendingAssignment = orders
                .Where(o => o.AssignedDesignerId is null &&
                            o.Status is not OrderStatus.Entregado and not OrderStatus.Cancelado)
                .OrderBy(o => o.ReceivedAt)
                .ThenBy(o => o.CreatedAt)
                .ToList();
            urgentOrders = orders
                .Where(o => o.Priority == OrderPriority.Urgente &&
                            o.Status is not OrderStatus.Entregado and not OrderStatus.Cancelado)
                .ToList();
            inProductionCount = orders.Count(o => o.Status is OrderStatus.DisenoAprobado or OrderStatus.EnImpresion
                or OrderStatus.EnPlanchado or OrderStatus.EnConfeccion);
            readyPickupCount = orders.Count(o => o.Status == OrderStatus.ListoEntrega);
            totalBilled = orders.Where(o => o.ChargeAmount > 0).Sum(o => o.ChargeAmount);
            return;
        }

        if (isDesigner)
        {
            designerMetrics = await MetricsService.GetDesignerMetricsAsync(userId);
            return;
        }

        if (isProduccion)
        {
            orders = await OrderService.GetOrdersForUserAsync(userId, roles);
            var history = await OrderService.GetProductionHistoryAsync();
            toAcceptImp = orders.Count(ProduccionOrderHelper.CanAccept);
            inProgressImp = orders.Count(o => o.Status is OrderStatus.EnImpresion or OrderStatus.EnPlanchado or OrderStatus.EnConfeccion);
            readyImp = orders.Count(o => o.Status == OrderStatus.ListoEntrega);
            historyCount = history.Count;
            totalChargedImp = history.Where(o => o.ChargeAmount > 0).Sum(o => o.ChargeAmount);
            return;
        }

        orders = await OrderService.GetOrdersForUserAsync(userId, roles);
    }

    private static int RingPct(int part, int total) =>
        total <= 0 ? 0 : Math.Clamp((int)Math.Round(part * 100.0 / total), 0, 100);

    private static int HoursPct(double? hours) =>
        hours.HasValue ? Math.Clamp((int)Math.Round(hours.Value / 72.0 * 100), 5, 100) : 0;

    private static string FormatHours(double? hours) =>
        hours.HasValue ? $"{hours.Value:F1}h" : "—";

    private static int TotalDesignerPending(DesignerPersonalMetrics m) =>
        Math.Max(1, m.PendingAcceptance + m.AcceptedNotStarted + m.InProgress);

    private static string ChartColor(int i)
    {
        string[] colors = ["#F0A500", "#FFD166", "#00E5CC", "#FF2D9A", "#81C784", "#4FC3F7"];
        return colors[i % colors.Length];
    }
}
