@page "/dashboard"
@layout AdminLayout
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Panel - SUBLISPORT GARCIA</PageTitle>

@if (isSuperAdminSupport)
{
    <h1 class="page-title">Panel de soporte — SuperAdmin</h1>
    <p class="page-subtitle">Vista general del sistema para informes y monitoreo</p>

    @if (metrics is not null)
    {
        <MetricsDashboardView Metrics="metrics" ShowUserCounts="true" TeamSectionTitle="Usuarios por rol" />
        <section class="panel-section">
            <h2>Accesos de soporte</h2>
            <div class="quick-links">
                <a href="/usuarios" class="quick-link">Gestionar usuarios e ingresar como soporte</a>
            </div>
        </section>
    }
}
else if (isAdmin)
{
    <h1 class="page-title">Panel de administración</h1>
    <p class="page-subtitle">Resumen operativo del día</p>

    <div class="stats-grid">
        <div class="stat-card"><span>Total pedidos</span><strong>@orders.Count</strong></div>
        <div class="stat-card"><span>Sin diseñador</span><strong>@pendingAssignment.Count</strong></div>
        <div class="stat-card"><span>Urgentes</span><strong>@urgentOrders.Count</strong></div>
        <div class="stat-card"><span>En producción</span><strong>@inProductionCount</strong></div>
        <div class="stat-card"><span>Por recoger</span><strong>@readyPickupCount</strong></div>
        <div class="stat-card"><span>Cobros registrados</span><strong>S/ @totalBilled.ToString("N2")</strong></div>
    </div>

    @if (pendingAssignment.Count > 0)
    {
        <section class="panel-section panel-highlight">
            <div class="section-header-row">
                <h2>Asignar diseñador (@pendingAssignment.Count)</h2>
                <a href="/pedidos/nuevo" class="quick-link">+ Nuevo pedido</a>
            </div>
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr><th>N°</th><th>Cliente</th><th>Prenda</th><th>Entrega</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var order in pendingAssignment.Take(5))
                        {
                            <tr>
                                <td>@order.OrderNumber</td>
                                <td>@order.ClientName</td>
                                <td>@order.GarmentType</td>
                                <td>@(order.AgreedDeliveryDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                <td><a href="/pedidos/@order.Id" class="btn-action btn-edit">Asignar</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (activeTracking.Count > 0)
    {
        <section class="panel-section panel-highlight">
            <div class="section-header-row">
                <h2>Seguimiento de pedidos (@activeTracking.Count)</h2>
                <a href="/pedidos" class="quick-link">Ver todos</a>
            </div>
            <p class="field-hint">Recorrido por horas — abra un pedido para ver el historial completo.</p>
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr><th>N°</th><th>Cliente</th><th>Estado</th><th>Último movimiento</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var order in activeTracking.Take(8))
                        {
                            var milestones = OrderJourneyHelper.BuildMilestones(order);
                            var last = milestones.LastOrDefault();
                            <tr>
                                <td>@order.OrderNumber</td>
                                <td>@order.ClientName</td>
                                <td>@OrderDisplayHelper.GetStatusLabel(order)</td>
                                <td>
                                    @if (last is not null)
                                    {
                                        <span>@last.Area · @last.At.ToLocalTime().ToString("dd/MM HH:mm")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td><a href="/pedidos/@order.Id" class="btn-action btn-edit">Seguimiento</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <section class="panel-section">
        <h2>Accesos rápidos</h2>
        <div class="quick-links">
            <a href="/pedidos/nuevo" class="quick-link">+ Registrar pedido</a>
            <a href="/pedidos" class="quick-link">Seguimiento de pedidos</a>
        </div>
    </section>
}
else if (isDesigner)
{
    <h1 class="page-title">Panel de diseño</h1>
    <p class="page-subtitle">Sus pedidos asignados y métricas personales</p>

    @if (designerMetrics is not null)
    {
        <div class="stats-grid">
            <div class="stat-card"><span>Por aceptar</span><strong>@designerMetrics.PendingAcceptance</strong></div>
            <div class="stat-card"><span>Aceptados / por iniciar</span><strong>@designerMetrics.AcceptedNotStarted</strong></div>
            <div class="stat-card"><span>En diseño activo</span><strong>@designerMetrics.InProgress</strong></div>
            <div class="stat-card"><span>Culminados (total)</span><strong>@designerMetrics.CompletedTotal</strong></div>
            <div class="stat-card"><span>Culminados (mes)</span><strong>@designerMetrics.CompletedThisMonth</strong></div>
            <div class="stat-card"><span>Urgentes pendientes</span><strong>@designerMetrics.UrgentPending</strong></div>
        </div>

        @if (designerMetrics.AvgHoursToComplete.HasValue)
        {
            <p class="page-subtitle">Tiempo promedio por diseño: <strong>@($"{designerMetrics.AvgHoursToComplete.Value:F1} h")</strong></p>
        }

        @if (designerMetrics.PendingOrders.Count > 0)
        {
            <section class="panel-section panel-highlight">
                <div class="section-header-row">
                    <h2>Pendientes de trabajo (@designerMetrics.PendingOrders.Count)</h2>
                    <a href="/pedidos" class="quick-link">Ver todos</a>
                </div>
                <div class="order-cards order-cards-compact">
                    @foreach (var order in designerMetrics.PendingOrders.Take(6))
                    {
                        var waUrl = WhatsAppHelper.BuildChatUrl(order.ClientPhone, WhatsAppHelper.BuildOrderMessage(order.ClientName, order.OrderNumber));
                        <article class="order-card @(DesignerOrderHelper.CanAccept(order) ? "card-new" : "card-active")">
                            <div class="order-card-header">
                                <strong>@order.OrderNumber</strong>
                                <span class="badge stage-badge">@DesignerOrderHelper.GetDesignerStageLabel(order)</span>
                            </div>
                            <div class="order-card-body">
                                <p>@order.ClientName · @order.GarmentType</p>
                                @if (waUrl is not null)
                                {
                                    <a href="@waUrl" target="_blank" rel="noopener noreferrer" class="whatsapp-link whatsapp-link-sm">📱 WhatsApp</a>
                                }
                            </div>
                            <a href="/pedidos/@order.Id" class="btn-action btn-edit">Abrir</a>
                        </article>
                    }
                </div>
            </section>
        }

        @if (designerMetrics.CompletedOrders.Count > 0)
        {
            <section class="panel-section">
                <h2>Últimos diseños culminados</h2>
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr><th>N°</th><th>Cliente</th><th>Prenda</th><th>Estado</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var order in designerMetrics.CompletedOrders)
                            {
                                <tr>
                                    <td>@order.OrderNumber</td>
                                    <td>@order.ClientName</td>
                                    <td>@order.GarmentType</td>
                                    <td>@DesignerOrderHelper.GetDesignerStageLabel(order)</td>
                                    <td><a href="/pedidos/@order.Id">Ver</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }

    <section class="panel-section">
        <h2>Accesos rápidos</h2>
        <div class="quick-links">
            <a href="/pedidos" class="quick-link">Ver mis diseños</a>
        </div>
    </section>
}
else if (isProduccion)
{
    <h1 class="page-title">Panel de producción</h1>
    <p class="page-subtitle">Impresión · Planchado · Confección · Cobros</p>

    <div class="stats-grid">
        <div class="stat-card"><span>Por aceptar</span><strong>@toAcceptImp</strong></div>
        <div class="stat-card"><span>En trabajo</span><strong>@inProgressImp</strong></div>
        <div class="stat-card"><span>Pendiente por recoger</span><strong>@readyImp</strong></div>
        <div class="stat-card"><span>Cobros registrados</span><strong>S/ @totalChargedImp.ToString("N2")</strong></div>
        <div class="stat-card"><span>En historial</span><strong>@historyCount</strong></div>
    </div>

    <section class="panel-section">
        <h2>Accesos rápidos</h2>
        <div class="quick-links">
            <a href="/produccion" class="quick-link">Cola activa</a>
            <a href="/produccion/historial" class="quick-link">Historial y boletas</a>
        </div>
    </section>
}
else
{
    <h1 class="page-title">Panel de control</h1>
    <section class="panel-section">
        <h2>Accesos rápidos</h2>
    </section>
}

@code {
    [Inject] private OrderService OrderService { get; set; } = default!;
    [Inject] private MetricsService MetricsService { get; set; } = default!;
    [Inject] private IHttpContextAccessor HttpContextAccessor { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private List<Order> orders = [];
    private List<Order> pendingAssignment = [];
    private List<Order> activeTracking = [];
    private List<Order> urgentOrders = [];
    private SystemMetrics? metrics;
    private DesignerPersonalMetrics? designerMetrics;
    private bool isSuperAdminSupport;
    private bool isAdmin;
    private bool isDesigner;
    private bool isProduccion;
    private int inProductionCount;
    private int readyPickupCount;
    private int toAcceptImp;
    private int inProgressImp;
    private int readyImp;
    private int historyCount;
    private decimal totalChargedImp;
    private decimal totalBilled;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState;
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId is null) return;

        var roles = auth.User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();
        isSuperAdminSupport = ImpersonationHelper.IsSuperAdminSupportMode(roles, HttpContextAccessor.HttpContext);
        isAdmin = roles.Contains(AppRoles.Admin) && !isSuperAdminSupport;
        isDesigner = roles.Contains(AppRoles.Designer) && !isAdmin && !isSuperAdminSupport;
        isProduccion = roles.Contains(AppRoles.Production) && !isAdmin && !isSuperAdminSupport;

        if (isSuperAdminSupport)
        {
            metrics = await MetricsService.GetSystemMetricsAsync();
            return;
        }

        if (isAdmin)
        {
            orders = await OrderService.GetOrdersForUserAsync(userId, roles);
            activeTracking = orders
                .Where(o => o.Status is not OrderStatus.Entregado and not OrderStatus.Cancelado)
                .OrderByDescending(o => o.CreatedAt)
                .ToList();
            pendingAssignment = orders
                .Where(o => o.AssignedDesignerId is null &&
                            o.Status is not OrderStatus.Entregado and not OrderStatus.Cancelado)
                .OrderByDescending(o => o.Priority)
                .ThenBy(o => o.AgreedDeliveryDate)
                .ToList();
            urgentOrders = orders
                .Where(o => o.Priority == OrderPriority.Urgente &&
                            o.Status is not OrderStatus.Entregado and not OrderStatus.Cancelado)
                .ToList();
            inProductionCount = orders.Count(o => o.Status is OrderStatus.DisenoAprobado or OrderStatus.EnImpresion
                or OrderStatus.EnPlanchado or OrderStatus.EnConfeccion);
            readyPickupCount = orders.Count(o => o.Status == OrderStatus.ListoEntrega);
            totalBilled = orders.Where(o => o.ChargeAmount > 0).Sum(o => o.ChargeAmount);
            return;
        }

        if (isDesigner)
        {
            designerMetrics = await MetricsService.GetDesignerMetricsAsync(userId);
            return;
        }

        if (isProduccion)
        {
            orders = await OrderService.GetOrdersForUserAsync(userId, roles);
            var history = await OrderService.GetProductionHistoryAsync();
            toAcceptImp = orders.Count(ProduccionOrderHelper.CanAccept);
            inProgressImp = orders.Count(o => o.Status is OrderStatus.EnImpresion or OrderStatus.EnPlanchado or OrderStatus.EnConfeccion);
            readyImp = orders.Count(o => o.Status == OrderStatus.ListoEntrega);
            historyCount = history.Count;
            totalChargedImp = history.Where(o => o.ChargeAmount > 0).Sum(o => o.ChargeAmount);
            return;
        }

        orders = await OrderService.GetOrdersForUserAsync(userId, roles);
    }
}
