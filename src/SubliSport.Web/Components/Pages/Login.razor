@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]

<PageTitle>Ingreso - SUBLISPORT GARCIA</PageTitle>

<div class="login-card">
    <div class="login-header">
        <h1>SUBLISPORT <span>GARCIA</span></h1>
        <p>Sistema de gestión interno</p>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert-error">@errorMessage</div>
    }

    <form method="post" action="/account/login">
        <div class="form-group">
            <label>Correo electrónico</label>
            <input name="Email" type="email" value="@email" class="form-control" autocomplete="username" required />
        </div>
        <div class="form-group">
            <label>Contraseña</label>
            <input name="Password" type="password" class="form-control" autocomplete="current-password" required />
        </div>
        <label class="checkbox-row">
            <input name="RememberMe" type="checkbox" value="true" />
            Recordarme
        </label>
        <button type="submit" class="btn-login">INGRESAR</button>
    </form>

    <a href="/" class="back-link">← Volver al sitio público</a>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    private string email = string.Empty;
    private string? errorMessage;

    protected override void OnInitialized()
    {
        email = Email ?? string.Empty;
        errorMessage = Error switch
        {
            "invalid" => "Credenciales inválidas. Verifique correo y contraseña.",
            "inactive" => "Esta cuenta está INACTIVA. Pida al SuperAdmin que la active en Usuarios.",
            "locked" => "Cuenta bloqueada temporalmente. Intente en 15 minutos.",
            "empty" => "Ingrese correo y contraseña.",
            "failed" => "No se pudo iniciar sesión. Intente de nuevo.",
            _ => null
        };
    }
}
