@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]

<PageTitle>Ingreso - SUBLISPORT GARCIA</PageTitle>

<div class="login-card">
    <div class="login-header">
        <h1>SUBLISPORT <span>GARCIA</span></h1>
        <p>Sistema de gestión interno</p>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert-error">@errorMessage</div>
    }

    <form method="post" @formname="login">
        <AntiforgeryToken />
        <div class="form-group">
            <label>Correo electrónico</label>
            <input name="Email" type="email" value="@(Input?.Email ?? "")" class="form-control" autocomplete="username" required />
        </div>
        <div class="form-group">
            <label>Contraseña</label>
            <input name="Password" type="password" class="form-control" autocomplete="current-password" required />
        </div>
        <label class="checkbox-row">
            <input name="RememberMe" type="checkbox" value="true" checked="@(Input?.RememberMe ?? false)" />
            Recordarme
        </label>
        <button type="submit" class="btn-login">INGRESAR</button>
    </form>

    <a href="/" class="back-link">← Volver al sitio público</a>
</div>

@code {
    [SupplyParameterFromForm(FormName = "login")]
    private InputModel? Input { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [Inject] private SignInManager<ApplicationUser> SignInManager { get; set; } = default!;
    [Inject] private UserManager<ApplicationUser> UserManager { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (HttpMethods.IsPost(HttpContext.Request.Method) && Input is not null)
        {
            await HandleLoginAsync();
        }
    }

    private async Task HandleLoginAsync()
    {
        if (string.IsNullOrWhiteSpace(Input!.Email) || string.IsNullOrWhiteSpace(Input.Password))
        {
            errorMessage = "Ingrese correo y contraseña.";
            return;
        }

        try
        {
            var user = await UserManager.FindByEmailAsync(Input!.Email.Trim());
            if (user is null || !user.IsActive)
            {
                errorMessage = "Credenciales inválidas.";
                return;
            }

            var result = await SignInManager.PasswordSignInAsync(
                user.UserName!,
                Input!.Password,
                Input.RememberMe,
                lockoutOnFailure: true);

            if (result.IsLockedOut)
            {
                errorMessage = "Cuenta bloqueada temporalmente. Intente más tarde.";
                return;
            }

            if (!result.Succeeded)
            {
                errorMessage = "Credenciales inválidas.";
                return;
            }

            user.LastLoginAt = DateTime.UtcNow;
            await UserManager.UpdateAsync(user);

            Navigation.NavigateTo("/dashboard", forceLoad: true);
        }
        catch (Exception)
        {
            errorMessage = "Error al iniciar sesión. Verifique sus credenciales e intente de nuevo.";
        }
    }

    private sealed class InputModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public bool RememberMe { get; set; }
    }
}
