@page "/usuarios"
@layout AdminLayout
@attribute [Authorize(Roles = "SuperAdmin")]
@rendermode InteractiveServer

<PageTitle>Usuarios - SUBLISPORT GARCIA</PageTitle>

<h1 class="page-title">Gestión de usuarios</h1>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert-success">@message</div>
}
@if (!string.IsNullOrEmpty(error))
{
    <div class="alert-error">@error</div>
}

<section class="panel-section">
    <h2>@(editingUserId is null ? "Crear nuevo usuario" : "Editar usuario")</h2>
    <EditForm Model="model" FormName="userForm" OnValidSubmit="SaveUser" class="form-panel">
        <DataAnnotationsValidator />
        <div class="form-grid">
            <div class="form-group">
                <label>Nombre completo</label>
                <InputText @bind-value="model.FullName" class="form-control" />
                <ValidationMessage For="() => model.FullName" />
            </div>
            <div class="form-group">
                <label>Correo</label>
                <InputText @bind-value="model.Email" class="form-control" />
                <ValidationMessage For="() => model.Email" />
            </div>
            <div class="form-group">
                <label>@(editingUserId is null ? "Contraseña temporal" : "Nueva contraseña (opcional)")</label>
                <InputText type="password" @bind-value="model.Password" class="form-control" />
                @if (editingUserId is null)
                {
                    <ValidationMessage For="() => model.Password" />
                }
            </div>
            <div class="form-group">
                <label>Rol</label>
                <InputSelect @bind-value="model.Role" class="form-control">
                    @foreach (var role in AppRoles.All)
                    {
                        <option value="@role">@RoleHelper.GetLabel(role)</option>
                    }
                </InputSelect>
            </div>
            @if (editingUserId is not null)
            {
                <div class="form-group">
                    <label>Estado</label>
                    <InputSelect @bind-value="model.IsActive" class="form-control">
                        <option value="true">Activo</option>
                        <option value="false">Inactivo</option>
                    </InputSelect>
                </div>
            }
        </div>
        <div class="form-actions">
            <button type="submit" class="btn-primary">@(editingUserId is null ? "Crear usuario" : "Guardar cambios")</button>
            @if (editingUserId is not null)
            {
                <button type="button" class="btn-secondary" @onclick="CancelEdit">Cancelar</button>
            }
        </div>
    </EditForm>
</section>

<section class="panel-section">
    <h2>Usuarios registrados</h2>
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in users)
                {
                    var roles = userRoles.GetValueOrDefault(user.Id, []);
                    var roleLabel = roles.Count > 0 ? RoleHelper.GetLabel(roles[0]) : "—";
                    <tr>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td>@roleLabel</td>
                        <td>
                            <span class="badge @(user.IsActive ? "status-active" : "status-inactive")">
                                @(user.IsActive ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td>
                            <div class="action-buttons">
                                @if (user.Id != currentUserId && user.IsActive)
                                {
                                    <form method="post" action="/account/impersonate" class="inline-form">
                                        <input type="hidden" name="UserId" value="@user.Id" />
                                        <button type="submit" class="btn-action btn-support" title="Ingresar como este usuario sin cerrar sesión">
                                            Ingresar como
                                        </button>
                                    </form>
                                }
                                <button type="button" class="btn-action btn-edit" @onclick="() => StartEdit(user)">Editar</button>
                                <button type="button" class="btn-action @(user.IsActive ? "btn-warn" : "btn-success")" @onclick="() => ToggleActive(user.Id)">
                                    @(user.IsActive ? "Desactivar" : "Activar")
                                </button>
                                <button type="button" class="btn-action btn-danger" @onclick="() => DeleteUser(user.Id, user.FullName)">Eliminar</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    [Inject] private UserManagementService UserManagementService { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private List<ApplicationUser> users = [];
    private Dictionary<string, IList<string>> userRoles = new();
    private readonly UserFormModel model = new();
    private string? editingUserId;
    private string? currentUserId;
    private string? message;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState;
        currentUserId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        users = await UserManagementService.GetAllUsersAsync();
        userRoles = new Dictionary<string, IList<string>>();
        foreach (var user in users)
        {
            userRoles[user.Id] = await UserManagementService.GetUserRolesAsync(user);
        }
    }

    private async Task SaveUser()
    {
        error = null;
        message = null;

        if (editingUserId is null)
        {
            if (string.IsNullOrWhiteSpace(model.Password))
            {
                error = "Ingrese una contraseña temporal.";
                return;
            }

            var (success, err) = await UserManagementService.CreateUserAsync(
                new CreateUserRequest(model.Email, model.FullName, model.Password, model.Role),
                isSuperAdmin: true);

            if (!success)
            {
                error = err;
                return;
            }

            message = "Usuario creado correctamente.";
        }
        else
        {
            var (success, err) = await UserManagementService.UpdateUserAsync(
                new UpdateUserRequest(editingUserId, model.Email, model.FullName, model.Role, model.IsActive, model.Password),
                currentUserId ?? string.Empty,
                isSuperAdmin: true);

            if (!success)
            {
                error = err;
                return;
            }

            message = "Usuario actualizado correctamente.";
            editingUserId = null;
        }

        ResetForm();
        await LoadUsersAsync();
    }

    private void StartEdit(ApplicationUser user)
    {
        editingUserId = user.Id;
        model.FullName = user.FullName;
        model.Email = user.Email ?? string.Empty;
        model.Password = string.Empty;
        model.IsActive = user.IsActive;
        model.Role = userRoles.GetValueOrDefault(user.Id, [AppRoles.Admin]).FirstOrDefault() ?? AppRoles.Admin;
        error = null;
        message = null;
    }

    private void CancelEdit()
    {
        editingUserId = null;
        ResetForm();
    }

    private void ResetForm()
    {
        model.FullName = string.Empty;
        model.Email = string.Empty;
        model.Password = string.Empty;
        model.Role = AppRoles.Admin;
        model.IsActive = true;
    }

    private async Task ToggleActive(string userId)
    {
        var (success, err) = await UserManagementService.ToggleActiveAsync(userId, currentUserId ?? string.Empty, isSuperAdmin: true);
        if (!success)
        {
            error = err;
            return;
        }

        message = "Estado actualizado.";
        error = null;
        await LoadUsersAsync();
    }

    private async Task DeleteUser(string userId, string fullName)
    {
        var (success, err) = await UserManagementService.DeleteUserAsync(userId, currentUserId ?? string.Empty, isSuperAdmin: true);
        if (!success)
        {
            error = err;
            return;
        }

        message = $"Usuario {fullName} eliminado.";
        error = null;
        if (editingUserId == userId)
        {
            CancelEdit();
        }
        await LoadUsersAsync();
    }

    private sealed class UserFormModel
    {
        [Required(ErrorMessage = "Ingrese el nombre.")]
        public string FullName { get; set; } = string.Empty;

        [Required, EmailAddress]
        public string Email { get; set; } = string.Empty;

        public string Password { get; set; } = string.Empty;

        public string Role { get; set; } = AppRoles.Admin;

        public bool IsActive { get; set; } = true;
    }
}
