@using SubliSport.Domain.Entities

@if (UltraCompact)
{
    <div class="circle-pick-row">
        @foreach (var designer in SortedDesigners)
        {
            var workload = Workloads.GetValueOrDefault(designer.Id) ?? DesignerWorkloadHelper.Empty;
            var isSelected = SelectedDesignerId == designer.Id;
            var firstName = designer.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? designer.FullName;
            var initials = GetInitials(designer.FullName);
            <button type="button"
                    class="circle-pick @(isSelected ? "active" : "")"
                    @onclick="() => SelectDesigner(designer.Id)">
                <span class="circle-pick-ring">
                    <span class="circle-pick-ring-text">@initials</span>
                    <span class="circle-pick-badge">@workload.TotalPendientes</span>
                </span>
                <span class="circle-pick-label">@firstName</span>
            </button>
        }
    </div>
}
else
{
    <div class="designer-picker designer-picker-compact">
        @foreach (var designer in SortedDesigners)
        {
            var workload = Workloads.GetValueOrDefault(designer.Id) ?? DesignerWorkloadHelper.Empty;
            var isSelected = SelectedDesignerId == designer.Id;
            var isCurrent = CurrentDesignerId == designer.Id;
            var isRecommended = designer.Id == LightestDesignerId;
            <button type="button"
                    class="designer-card designer-card-compact @(isSelected ? "selected" : "") @(isCurrent ? "current" : "") @(isRecommended ? "recommended" : "")"
                    @onclick="() => SelectDesigner(designer.Id)">
                <strong>@designer.FullName</strong>
                @if (isRecommended)
                {
                    <em class="designer-tag">Menor carga</em>
                }
                <ul class="designer-workload-list">
                    <li><span>Sin aceptar</span><b>@workload.SinAceptar</b></li>
                    <li><span>Pendientes</span><b>@workload.Pendientes</b></li>
                </ul>
            </button>
        }
    </div>
}

@code {
    [Parameter] public IReadOnlyList<ApplicationUser> Designers { get; set; } = [];
    [Parameter] public Dictionary<string, DesignerWorkloadInfo> Workloads { get; set; } = new();
    [Parameter] public string? SelectedDesignerId { get; set; }
    [Parameter] public string? CurrentDesignerId { get; set; }
    [Parameter] public bool UltraCompact { get; set; }
    [Parameter] public EventCallback<string?> SelectedDesignerIdChanged { get; set; }

    private string? LightestDesignerId => Designers
        .OrderBy(d => Workloads.GetValueOrDefault(d.Id)?.TotalPendientes ?? 0)
        .ThenBy(d => d.FullName)
        .FirstOrDefault()?.Id;

    private IEnumerable<ApplicationUser> SortedDesigners =>
        Designers.OrderBy(d => Workloads.GetValueOrDefault(d.Id)?.TotalPendientes ?? 0)
            .ThenBy(d => d.FullName);

    private Task SelectDesigner(string designerId) =>
        SelectedDesignerIdChanged.InvokeAsync(designerId);

    private static string GetInitials(string fullName)
    {
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}";
    }
}
