@using SubliSport.Domain.Pricing

@if (ReadOnly)
{
    <section class="panel-section">
        <h2>Cobro e impresión</h2>
        @if (order.ChargeAmount <= 0 && order.CalculatedTotal <= 0)
        {
            <p class="empty-state">Sin registro de cobro aún.</p>
        }
        else
        {
            <dl class="detail-list pricing-summary">
                @if (order.FabricMeters.HasValue)
                {
                    <div><dt>Metraje</dt><dd>@order.FabricMeters.Value.ToString("N2") m @(order.FabricTypeName != null ? $"· {order.FabricTypeName}" : "")</dd></div>
                }
                @if (order.CalculatedPrintPressCost > 0)
                {
                    <div><dt>Impresión + planchado</dt><dd>S/ @order.CalculatedPrintPressCost.Value.ToString("N2")</dd></div>
                }
                @if (order.CalculatedFabricCost > 0)
                {
                    <div><dt>Tela</dt><dd>S/ @order.CalculatedFabricCost.Value.ToString("N2")</dd></div>
                }
                @if (order.CalculatedConfectionCost > 0)
                {
                    <div><dt>Confección</dt><dd>S/ @order.CalculatedConfectionCost.Value.ToString("N2")</dd></div>
                }
                <div><dt>Total calculado</dt><dd>S/ @order.CalculatedTotal.ToString("N2")</dd></div>
                <div><dt>Precio a cobrar</dt><dd><strong class="price-tag">S/ @order.ChargeAmount.ToString("N2")</strong></dd></div>
                @if (!string.IsNullOrWhiteSpace(order.PricingNotes))
                {
                    <div><dt>Notas cobro</dt><dd>@order.PricingNotes</dd></div>
                }
            </dl>
        }
    </section>
}
else
{
    <section class="panel-section panel-highlight">
        <h2>Calculadora de cobro</h2>
        <p class="field-hint">Parámetros definidos por SuperAdmin. Ingrese metraje y confirme el precio a cobrar.</p>

        <div class="form-grid">
            <div class="form-group">
                <label>Tipo de tela</label>
                <select @bind="fabricTypeId" @bind:after="Recalculate" class="form-control">
                    @foreach (var f in settings.Fabrics)
                    {
                        <option value="@f.Id">@f.Name</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Metraje principal (m) *</label>
                <input type="number" step="0.01" @bind="fabricMeters" @bind:after="Recalculate" class="form-control" />
            </div>
            <div class="form-group">
                <label>Tela RIP (opcional)</label>
                <select @bind="fabricRipIdStr" @bind:after="Recalculate" class="form-control">
                    <option value="">— Sin RIP —</option>
                    @foreach (var f in settings.Fabrics)
                    {
                        <option value="@f.Id">@f.Name</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Metraje RIP (m)</label>
                <input type="number" step="0.01" @bind="fabricMetersRip" @bind:after="Recalculate" class="form-control" />
            </div>
        </div>

        <div class="toggle-row">
            <label class="checkbox-row">
                <input type="checkbox" @bind="serviceOnly" @bind:after="Recalculate" />
                Solo servicio impresión + planchado (sin tela ni confección)
            </label>
            <label class="checkbox-row">
                <input type="checkbox" @bind="includesConfection" @bind:after="Recalculate" disabled="@serviceOnly" />
                Incluye confección
            </label>
        </div>

        @if (result is not null && fabricMeters > 0)
        {
            <div class="pricing-breakdown">
                <div class="rrow"><span>Kilos tela (@result.FabricName)</span><strong>@result.KilosMain.ToString("N3") kg</strong></div>
                @if (result.FabricRipCost > 0)
                {
                    <div class="rrow"><span>Tela RIP (@result.FabricRipName)</span><strong>S/ @result.FabricRipCost.ToString("N2")</strong></div>
                }
                @if (!serviceOnly && result.FabricCost > 0)
                {
                    <div class="rrow"><span>Costo tela</span><strong>S/ @result.FabricCost.ToString("N2")</strong></div>
                }
                <div class="rrow"><span>Impresión + planchado (@fabricMeters.ToString("N2") m)</span><strong>S/ @result.PrintPressCost.ToString("N2")</strong></div>
                @if (result.LaserCost > 0)
                {
                    <div class="rrow"><span>Corte láser</span><strong>S/ @result.LaserCost.ToString("N2")</strong></div>
                }
                @if (result.ExtraMeterCost > 0)
                {
                    <div class="rrow"><span>Costos extra/m</span><strong>S/ @result.ExtraMeterCost.ToString("N2")</strong></div>
                }
                @if (result.ConfectionCost > 0)
                {
                    <div class="rrow"><span>Confección</span><strong>S/ @result.ConfectionCost.ToString("N2")</strong></div>
                }
                <div class="rrow rrow-total"><span>Total sugerido</span><strong>S/ @result.SuggestedTotal.ToString("N2")</strong></div>
            </div>
        }

        <div class="form-group">
            <label>Precio a cobrar (S/) *</label>
            <input type="number" step="0.01" @bind="chargeAmount" class="form-control price-input" />
        </div>
        <div class="form-group">
            <label>Notas de cobro</label>
            <InputTextArea @bind-value="pricingNotes" class="form-control" rows="2" placeholder="Abono, forma de pago, observaciones..." />
        </div>

        @if (!ReadOnly)
        {
            <button type="button" class="btn-primary" @onclick="SavePricing" disabled="@(fabricMeters <= 0 || chargeAmount <= 0)">
                Guardar cobro del pedido
            </button>
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public Order Order { get; set; } = default!;
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    [Inject] private PricingConfigurationService PricingConfig { get; set; } = default!;
    [Inject] private OrderService OrderService { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private Order order = default!;
    private PricingSettingsData settings = PricingSettingsData.CreateDefault();
    private OrderPricingResult? result;

    private int fabricTypeId = 1;
    private string fabricRipIdStr = "";
    private decimal fabricMeters;
    private decimal fabricMetersRip;
    private bool includesConfection = true;
    private bool serviceOnly;
    private decimal chargeAmount;
    private string? pricingNotes;

    protected override async Task OnParametersSetAsync()
    {
        order = Order;
        settings = await PricingConfig.GetSettingsAsync();

        fabricTypeId = order.FabricTypeId ?? settings.Fabrics.FirstOrDefault()?.Id ?? 1;
        fabricRipIdStr = order.FabricTypeRipId?.ToString() ?? "";
        fabricMeters = order.FabricMeters ?? 0;
        fabricMetersRip = order.FabricMetersRip ?? 0;
        includesConfection = order.IncludesConfection;
        serviceOnly = order.ServiceOnlyPrintPress;
        chargeAmount = order.ChargeAmount > 0 ? order.ChargeAmount : order.CalculatedTotal;
        pricingNotes = order.PricingNotes;
        Recalculate();
    }

    private void Recalculate()
    {
        if (serviceOnly)
        {
            includesConfection = false;
        }

        if (fabricMeters <= 0)
        {
            result = null;
            return;
        }

        var ripId = int.TryParse(fabricRipIdStr, out var parsed) ? parsed : (int?)null;

        var input = new OrderPricingInput(
            fabricTypeId,
            fabricMeters,
            ripId,
            fabricMetersRip,
            includesConfection,
            serviceOnly,
            order.GarmentType.Contains("Conjunto", StringComparison.OrdinalIgnoreCase),
            order.Quantity);

        result = PricingCalculatorService.Calculate(settings, input);

        if (chargeAmount <= 0 || chargeAmount == order.CalculatedTotal)
        {
            chargeAmount = result.SuggestedTotal;
        }
    }

    private async Task SavePricing()
    {
        if (result is null || fabricMeters <= 0) return;

        var auth = await AuthState;
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId is null) return;

        var ripId = int.TryParse(fabricRipIdStr, out var parsed) ? parsed : (int?)null;

        var input = new OrderPricingInput(
            fabricTypeId,
            fabricMeters,
            ripId,
            fabricMetersRip,
            includesConfection,
            serviceOnly,
            order.GarmentType.Contains("Conjunto", StringComparison.OrdinalIgnoreCase),
            order.Quantity);

        await OrderService.SaveOrderPricingAsync(
            order.Id, userId, input, result, chargeAmount, pricingNotes, includesConfection, serviceOnly);

        await OnSaved.InvokeAsync();
    }
}
