@using SubliSport.Domain.Pricing

@if (ReadOnly)
{
    @if (ProductionMode)
    {
        <section class="panel-section charge-mini-section">
            <h2>Cobro al cliente</h2>
            @if (order.ChargeAmount > 0)
            {
                <div class="charge-mini-box">
                    <span class="charge-mini-label">Total a cobrar</span>
                    <strong class="charge-mini-amount">S/ @order.ChargeAmount.ToString("N2")</strong>
                    @if (order.IncludesIgv)
                    {
                        <span class="charge-mini-hint">incl. IGV</span>
                    }
                </div>
            }
            else
            {
                <p class="empty-state">Sin monto registrado aún.</p>
            }
        </section>
    }
    else
    {
        <section class="panel-section">
            <h2>Cobro e impresión</h2>
            @if (order.ChargeAmount <= 0 && order.CalculatedTotal <= 0)
            {
                <p class="empty-state">Sin registro de cobro aún.</p>
            }
            else
            {
                <dl class="detail-list pricing-summary">
                    @if (order.FabricMeters.HasValue)
                    {
                        <div><dt>Metraje</dt><dd>@order.FabricMeters.Value.ToString("N2") m @if (!order.ClientOwnFabric && order.FabricTypeName != null){<text>· @order.FabricTypeName</text>} @if (order.ClientOwnFabric){<text>· Tela del cliente</text>}</dd></div>
                    }
                    @if (order.CalculatedPrintPressCost > 0)
                    {
                        <div><dt>Impresión + planchado</dt><dd>S/ @order.CalculatedPrintPressCost.Value.ToString("N2")</dd></div>
                    }
                    <div><dt>Precio a cobrar</dt><dd><strong class="price-tag">S/ @order.ChargeAmount.ToString("N2")</strong></dd></div>
                </dl>
            }
        </section>
    }
}
else
{
    <section class="panel-section panel-highlight">
        <div class="section-header-row">
            <h2>Calculadora MYPE / producción</h2>
            <span class="@ClientPricingTierHelper.GetBadgeClass(order.PricingTier)">@ClientPricingTierHelper.GetLabel(order.PricingTier)</span>
        </div>

        @if (order.PricingTier == ClientPricingTier.DirectRetail && ProductionMode)
        {
            <p class="dashboard-insight">Pedido <strong>cliente directo</strong> (precio por prenda en cotizar.html). Use esta calculadora solo si aplica cobro por metraje en taller.</p>
        }
        else
        {
            <p class="field-hint">Servicio B2B: metraje × S/ @settings.PrintPressPricePerMeter.ToString("N2")/m (impresión + planchado). La confección suma aparte si aplica.</p>
        }

        <div class="service-type-cards">
            <button type="button" class="service-type-card @(selectedService == ServiceTypeHelper.PrintPressOnly ? "active" : "")" @onclick="() => SelectService(ServiceTypeHelper.PrintPressOnly)">
                <strong>Diseño + impresión + planchado</strong>
                <span>Sin confección — tela del taller o del cliente.</span>
            </button>
            <button type="button" class="service-type-card @(selectedService == ServiceTypeHelper.WithConfection ? "active" : "")" @onclick="() => SelectService(ServiceTypeHelper.WithConfection)">
                <strong>Con confección</strong>
                <span>Incluye armado de prenda (polo, short, medias según pedido).</span>
            </button>
        </div>

        <div class="form-grid">
            @if (!clientOwnFabric)
            {
                <div class="form-group">
                    <label>Tipo de tela</label>
                    <select @bind="fabricTypeId" @bind:after="Recalculate" class="form-control">
                        @foreach (var f in settings.Fabrics)
                        {
                            <option value="@f.Id">@f.Name</option>
                        }
                    </select>
                </div>
            }
            <div class="form-group">
                <label>Metraje (m) *</label>
                <input type="number" step="0.01" @bind="fabricMeters" @bind:after="Recalculate" class="form-control" />
            </div>
            <div class="form-group">
                <label>Tela RIP (opcional)</label>
                <select @bind="fabricRipIdStr" @bind:after="Recalculate" class="form-control">
                    <option value="">— Sin RIP —</option>
                    @foreach (var f in settings.Fabrics)
                    {
                        <option value="@f.Id">@f.Name</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Metraje RIP (m)</label>
                <input type="number" step="0.01" @bind="fabricMetersRip" @bind:after="Recalculate" class="form-control" disabled="@string.IsNullOrEmpty(fabricRipIdStr)" />
            </div>
        </div>

        <div class="toggle-row production-options-grid">
            <label class="checkbox-row">
                <input type="checkbox" @bind="includesLaserCut" @bind:after="Recalculate" />
                Corte láser
            </label>
            <label class="checkbox-row">
                <input type="checkbox" @bind="clientOwnFabric" @bind:after="OnClientOwnFabricChanged" />
                Cliente trae tela propia
            </label>
            <label class="checkbox-row">
                <input type="checkbox" @bind="includesIgv" @bind:after="Recalculate" />
                Incluye IGV (18%)
            </label>
        </div>

        @if (!ProductionMode && result is not null && fabricMeters > 0)
        {
            <div class="pricing-breakdown">
                @if (!clientOwnFabric && !serviceOnlyPrintPress && result.FabricCost > 0)
                {
                    <div class="rrow"><span>Costo tela</span><strong>S/ @result.FabricCost.ToString("N2")</strong></div>
                }
                @if (result.FabricRipCost > 0)
                {
                    <div class="rrow"><span>Tela RIP</span><strong>S/ @result.FabricRipCost.ToString("N2")</strong></div>
                }
                <div class="rrow"><span>Impresión + planchado</span><strong>S/ @result.PrintPressCost.ToString("N2")</strong></div>
                @if (result.ConfectionCost > 0)
                {
                    <div class="rrow"><span>Confección</span><strong>S/ @result.ConfectionCost.ToString("N2")</strong></div>
                }
                <div class="rrow rrow-total"><span>Subtotal sugerido</span><strong>S/ @result.SuggestedTotal.ToString("N2")</strong></div>
            </div>
        }

        @if (ProductionMode && result is not null && fabricMeters > 0)
        {
            <p class="field-hint charge-suggested-hint">
                Sugerido: S/ @PricingDisplayHelper.TotalWithIgv(result.SuggestedTotal, includesIgv).ToString("N2")
                @(includesIgv ? " (con IGV)" : "")
            </p>
        }

        <div class="@(ProductionMode ? "charge-mini-edit" : "form-group")">
            <label>Precio a cobrar (S/) *</label>
            <input type="number" step="0.01" @bind="chargeAmount" class="form-control @(ProductionMode ? "charge-mini-input" : "price-input")" />
        </div>

        @if (!ProductionMode)
        {
            <div class="form-group">
                <label>Notas de cobro</label>
                <InputTextArea @bind-value="pricingNotes" class="form-control" rows="2" placeholder="Abono, forma de pago, observaciones..." />
            </div>
        }

        <button type="button" class="btn-primary" @onclick="SavePricing" disabled="@(fabricMeters <= 0 || chargeAmount <= 0)">
            Guardar cobro
        </button>
    </section>
}

@code {
    [Parameter, EditorRequired] public Order Order { get; set; } = default!;
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool ProductionMode { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    [Inject] private PricingConfigurationService PricingConfig { get; set; } = default!;
    [Inject] private OrderService OrderService { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private Order order = default!;
    private PricingSettingsData settings = PricingSettingsData.CreateDefault();
    private OrderPricingResult? result;

    private int fabricTypeId = 1;
    private string fabricRipIdStr = "";
    private decimal fabricMeters;
    private decimal fabricMetersRip;
    private bool includesConfection = true;
    private bool serviceOnlyPrintPress;
    private bool clientOwnFabric;
    private bool includesLaserCut;
    private bool includesIgv;
    private decimal chargeAmount;
    private string? pricingNotes;
    private string selectedService = ServiceTypeHelper.WithConfection;

    protected override async Task OnParametersSetAsync()
    {
        order = Order;
        try
        {
            settings = await PricingConfig.GetSettingsAsync();

            fabricTypeId = order.FabricTypeId ?? settings.Fabrics.FirstOrDefault()?.Id ?? 1;
            fabricRipIdStr = order.FabricTypeRipId?.ToString() ?? "";
            fabricMeters = order.FabricMeters ?? 0;
            fabricMetersRip = order.FabricMetersRip ?? 0;
            includesConfection = order.IncludesConfection;
            serviceOnlyPrintPress = order.ServiceOnlyPrintPress;
            clientOwnFabric = order.ClientOwnFabric;
            includesLaserCut = order.IncludesLaserCut;
            includesIgv = order.IncludesIgv;
            chargeAmount = order.ChargeAmount > 0 ? order.ChargeAmount : order.CalculatedTotal;
            pricingNotes = ProductionMode ? null : order.PricingNotes;

            if (clientOwnFabric)
            {
                serviceOnlyPrintPress = true;
                includesConfection = false;
                selectedService = ServiceTypeHelper.PrintPressOnly;
            }
            else
            {
                selectedService = serviceOnlyPrintPress || !includesConfection
                    ? ServiceTypeHelper.PrintPressOnly
                    : ServiceTypeHelper.WithConfection;
            }

            Recalculate();
        }
        catch
        {
            settings = PricingSettingsData.CreateDefault();
        }
    }

    private void SelectService(string serviceType)
    {
        selectedService = serviceType;
        if (serviceType == ServiceTypeHelper.PrintPressOnly)
        {
            serviceOnlyPrintPress = true;
            includesConfection = false;
        }
        else
        {
            serviceOnlyPrintPress = false;
            includesConfection = true;
        }

        Recalculate();
    }

    private void OnClientOwnFabricChanged()
    {
        if (clientOwnFabric)
        {
            SelectService(ServiceTypeHelper.PrintPressOnly);
        }

        Recalculate();
    }

    private void OnServiceOnlyChanged()
    {
        if (serviceOnlyPrintPress)
        {
            includesConfection = false;
        }

        Recalculate();
    }

    private void Recalculate()
    {
        if (clientOwnFabric)
        {
            serviceOnlyPrintPress = true;
            includesConfection = false;
        }

        if (serviceOnlyPrintPress)
        {
            includesConfection = false;
        }

        if (fabricMeters <= 0)
        {
            result = null;
            return;
        }

        var ripId = int.TryParse(fabricRipIdStr, out var parsed) ? parsed : (int?)null;

        var input = BuildInput(ripId);
        result = PricingCalculatorService.Calculate(settings, input);

        var suggested = PricingDisplayHelper.TotalWithIgv(result.SuggestedTotal, includesIgv);
        if (chargeAmount <= 0 || chargeAmount == order.CalculatedTotal || chargeAmount == order.ChargeAmount && order.ChargeAmount == PricingDisplayHelper.TotalWithIgv(order.CalculatedTotal, order.IncludesIgv))
        {
            chargeAmount = suggested;
        }
    }

    private OrderPricingInput BuildInput(int? ripId) => new(
        fabricTypeId,
        fabricMeters,
        ripId,
        fabricMetersRip,
        includesConfection,
        serviceOnlyPrintPress,
        clientOwnFabric,
        includesLaserCut,
        order.GarmentType.Contains("Conjunto", StringComparison.OrdinalIgnoreCase) ||
        order.GarmentType.Equals("Mixta", StringComparison.OrdinalIgnoreCase),
        order.Quantity);

    private async Task SavePricing()
    {
        if (result is null || fabricMeters <= 0) return;

        var auth = await AuthState;
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId is null) return;

        var ripId = int.TryParse(fabricRipIdStr, out var parsed) ? parsed : (int?)null;
        var input = BuildInput(ripId);

        await OrderService.SaveOrderPricingAsync(
            order.Id,
            userId,
            input,
            result,
            chargeAmount,
            ProductionMode ? null : pricingNotes,
            includesConfection,
            serviceOnlyPrintPress,
            clientOwnFabric,
            includesLaserCut,
            includesIgv);

        await OnSaved.InvokeAsync();
    }
}
