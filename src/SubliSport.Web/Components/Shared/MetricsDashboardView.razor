@using SubliSport.Web.Services

@if (Metrics is not null)
{
    <div class="stats-rings-grid">
        <StatRing Label="Total pedidos" Value="@Metrics.TotalOrders.ToString()" Percent="100" Color="#52B788" />
        <StatRing Label="Urgentes" Value="@Metrics.UrgentOrders.ToString()" Percent="@Pct(Metrics.UrgentOrders, Metrics.TotalOrders)" Color="#FF2D9A" />
        <StatRing Label="En diseño" Value="@Metrics.PendingDesign.ToString()" Percent="@Pct(Metrics.PendingDesign, Metrics.TotalOrders)" Color="#FFD166" />
        <StatRing Label="En producción" Value="@Metrics.InProduction.ToString()" Percent="@Pct(Metrics.InProduction, Metrics.TotalOrders)" Color="#52B788" />
        <StatRing Label="Entregados" Value="@Metrics.Delivered.ToString()" Percent="@Pct(Metrics.Delivered, Metrics.TotalOrders)" Color="#74CFA3" />
        @if (ShowUserCounts)
        {
            <StatRing Label="Usuarios activos" Value="@($"{Metrics.ActiveUsers}/{Metrics.TotalUsers}")" Percent="@Pct(Metrics.ActiveUsers, Math.Max(Metrics.TotalUsers, 1))" Color="#0891B2" />
        }
    </div>

    <div class="dashboard-charts-row">
        <section class="panel-section">
            <h2>Pedidos por estado</h2>
            <DonutChart LegendItems="statusLegend" CenterLabel="Pedidos" />
        </section>

        <section class="panel-section">
            <h2>@TeamSectionTitle</h2>
            <DonutChart LegendItems="teamLegend" CenterLabel="Equipo" />
        </section>

        <section class="panel-section">
            <h2>Tiempos promedio</h2>
            <div class="stats-rings-grid" style="margin-bottom:0">
                <StatRing Label="Diseño" Value="@FormatHours(Metrics.AvgDesignHours)" Percent="@HoursPct(Metrics.AvgDesignHours)" Color="#52B788" SubLabel="asignado → aprobado" />
                <StatRing Label="Producción" Value="@FormatHours(Metrics.AvgProductionHours)" Percent="@HoursPct(Metrics.AvgProductionHours)" Color="#0891B2" SubLabel="impresión → entrega" />
            </div>
        </section>
    </div>

    <section class="panel-section">
        <h2>Métricas por diseñador</h2>
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr><th>Nombre</th><th>Correo</th><th>Pedidos activos</th><th>Tiempo prom.</th></tr>
                </thead>
                <tbody>
                    @foreach (var d in Metrics.DesignerMetrics)
                    {
                        <tr>
                            <td>@d.FullName</td>
                            <td>@d.Email</td>
                            <td>@d.ActiveOrders</td>
                            <td>@FormatHours(d.AvgHoursInStage)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="panel-section">
        <h2>Métricas producción</h2>
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr><th>Nombre</th><th>Correo</th><th>Cola actual</th><th>Tiempo prom.</th></tr>
                </thead>
                <tbody>
                    @foreach (var p in Metrics.ProductionMetrics)
                    {
                        <tr>
                            <td>@p.FullName</td>
                            <td>@p.Email</td>
                            <td>@p.ActiveOrders</td>
                            <td>@FormatHours(p.AvgHoursInStage)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired] public SystemMetrics Metrics { get; set; } = default!;
    [Parameter] public bool ShowUserCounts { get; set; }
    [Parameter] public string TeamSectionTitle { get; set; } = "Equipo operativo";

    private List<DonutChart.LegendItem> statusLegend = [];
    private List<DonutChart.LegendItem> teamLegend = [];

    private static readonly string[] ChartColors = ["#52B788", "#FFD166", "#0891B2", "#FF2D9A", "#74CFA3", "#4FC3F7", "#888888"];

    protected override void OnParametersSet()
    {
        statusLegend = Metrics.OrdersByStatus
            .OrderByDescending(x => x.Value)
            .Select((item, i) => new DonutChart.LegendItem(item.Key, item.Value, ChartColors[i % ChartColors.Length]))
            .ToList();

        teamLegend = Metrics.UsersByRole
            .Select((item, i) => new DonutChart.LegendItem(item.Key, item.Value, ChartColors[(i + 2) % ChartColors.Length]))
            .ToList();
    }

    private static int Pct(int part, int total) =>
        total <= 0 ? 0 : Math.Clamp((int)Math.Round(part * 100.0 / total), 0, 100);

    private static int HoursPct(double? hours) =>
        hours.HasValue ? Math.Clamp((int)Math.Round(hours.Value / 72.0 * 100), 5, 100) : 0;

    private static string FormatHours(double? hours) =>
        hours.HasValue ? $"{hours.Value:F1}h" : "—";
}
