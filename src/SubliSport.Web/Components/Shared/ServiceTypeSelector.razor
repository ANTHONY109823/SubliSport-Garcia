@rendermode InteractiveServer

<div class="service-type-grid service-type-grid-3">
    @foreach (var opt in ServiceTypeHelper.Options)
    {
        var key = opt.Key;
        var isActive = IsSelected(key);
        <button type="button"
                class="service-type-card-v2 service-type-@key.Replace("_", "-") @(isActive ? "active" : "")"
                @onclick="() => ToggleAsync(key)">
            <span class="service-type-icon">@opt.Icon</span>
            <strong>@opt.Title</strong>
            <span>@opt.Description</span>
            <span class="client-type-check" aria-hidden="true">✓</span>
        </button>
    }
</div>

@code {
    [Parameter] public bool PrintPress { get; set; } = true;
    [Parameter] public bool LaserCut { get; set; }
    [Parameter] public bool Confection { get; set; }
    [Parameter] public EventCallback<(bool PrintPress, bool LaserCut, bool Confection)> SelectionChanged { get; set; }

    private bool IsSelected(string key) => key switch
    {
        ServiceTypeHelper.PrintPressOnly => PrintPress,
        ServiceTypeHelper.WithLaserCut => LaserCut,
        ServiceTypeHelper.WithConfection => Confection,
        _ => false
    };

    private async Task ToggleAsync(string key)
    {
        switch (key)
        {
            case ServiceTypeHelper.PrintPressOnly:
                PrintPress = !PrintPress;
                break;
            case ServiceTypeHelper.WithLaserCut:
                LaserCut = !LaserCut;
                break;
            case ServiceTypeHelper.WithConfection:
                Confection = !Confection;
                break;
        }

        await SelectionChanged.InvokeAsync((PrintPress, LaserCut, Confection));
    }
}
