@rendermode InteractiveServer

<div class="service-type-grid service-type-grid-3">
    @foreach (var opt in ServiceTypeHelper.Options)
    {
        var key = opt.Key;
        <button type="button"
                class="service-type-card-v2 service-type-@key.Replace('_', '-') @(SelectedService == key ? "active" : "")"
                @onclick="() => SelectAsync(key)">
            <span class="service-type-icon">@opt.Icon</span>
            <strong>@opt.Title</strong>
            <span>@opt.Description</span>
            <span class="client-type-check" aria-hidden="true">✓</span>
        </button>
    }
</div>

@code {
    [Parameter] public string SelectedService { get; set; } = ServiceTypeHelper.PrintPressOnly;
    [Parameter] public EventCallback<string> SelectedServiceChanged { get; set; }

    private async Task SelectAsync(string service)
    {
        if (SelectedService == service)
        {
            return;
        }

        SelectedService = service;
        await SelectedServiceChanged.InvokeAsync(service);
    }
}
