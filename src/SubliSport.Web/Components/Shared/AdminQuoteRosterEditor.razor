<div class="roster-panel @(Compact ? "roster-panel-compact" : "")">
    @if (!Compact)
    {
        <p class="roster-panel-subtitle">Lista por jugador / prenda (nombre · talla · número)</p>
    }

    <div class="roster-import-row">
        <a href="/templates/plantilla-lista-sublisport.csv" download class="roster-import-link">⬇ CSV</a>
        <div class="roster-upload-wrap">
            <InputFile OnChange="ImportCsvAsync" accept=".csv,text/csv" class="roster-file-overlay" />
            <span class="roster-upload-label">📄 CSV</span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(importMessage))
    {
        <p class="roster-import-status @(importError ? "text-error" : "text-ok")">@importMessage</p>
    }

    <div class="roster-entries">
        @for (var i = 0; i < Rows.Count; i++)
        {
            var row = Rows[i];
            var index = i;
            <div class="roster-entry">
                <div class="roster-field roster-field-name">
                    @if (!Compact) { <label>Nombre</label> }
                    <input class="form-control form-control-sm" @bind="row.Name" placeholder="Nombre" />
                </div>
                <div class="roster-field">
                    @if (!Compact) { <label>Talla</label> }
                    <input class="form-control form-control-sm" @bind="row.Size" placeholder="M" />
                </div>
                <div class="roster-field">
                    @if (!Compact) { <label>Número</label> }
                    <input class="form-control form-control-sm" @bind="row.Number" placeholder="10" />
                </div>
                <div class="roster-entry-actions">
                    @if (Rows.Count > 1)
                    {
                        <button type="button" class="roster-remove-btn" title="Quitar fila" @onclick="() => RemoveRow(index)">✕</button>
                    }
                </div>
            </div>
        }
    </div>

    <button type="button" class="roster-add-btn" @onclick="AddRow">+ fila</button>
</div>

@code {
    [Parameter] public List<RosterRowModel> Rows { get; set; } = [];
    [Parameter] public bool Compact { get; set; }

    private string? importMessage;
    private bool importError;

    private void AddRow() => Rows.Add(new RosterRowModel());

    private void RemoveRow(int index)
    {
        if (Rows.Count > 1)
        {
            Rows.RemoveAt(index);
        }
    }

    private async Task ImportCsvAsync(InputFileChangeEventArgs e)
    {
        importMessage = null;
        importError = false;
        var file = e.File;
        if (file is null)
        {
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(512 * 1024);
            using var reader = new StreamReader(stream);
            var text = await reader.ReadToEndAsync();
            var parsed = RosterCsvImportHelper.Parse(text);
            if (parsed.Count == 0)
            {
                importError = true;
                importMessage = "Sin filas válidas.";
                return;
            }

            Rows.Clear();
            foreach (var line in parsed)
            {
                Rows.Add(new RosterRowModel
                {
                    Name = line.Name,
                    Size = line.Size,
                    Number = line.Number
                });
            }

            importMessage = $"{parsed.Count} importados.";
        }
        catch (Exception ex)
        {
            importError = true;
            importMessage = ex.Message;
        }
    }

    public sealed class RosterRowModel
    {
        public string Name { get; set; } = string.Empty;
        public string Size { get; set; } = string.Empty;
        public string Number { get; set; } = string.Empty;
    }
}
