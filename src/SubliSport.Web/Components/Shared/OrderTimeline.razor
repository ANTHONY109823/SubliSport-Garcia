@if (milestones.Count == 0)
{
    <p class="empty-state">Sin movimientos registrados.</p>
}
else
{
    <ul class="history-list order-journey order-journey-compact">
        @for (var i = 0; i < milestones.Count; i++)
        {
            var item = milestones[i];
            var isLast = i == milestones.Count - 1;
            var elapsed = isLast
                ? DateTime.UtcNow - item.At
                : milestones[i + 1].At - item.At;

            <li class="journey-step-compact @(isLast ? "journey-step-current" : "")">
                <div class="journey-area">@item.Area</div>
                <div class="journey-meta">
                    <time datetime="@item.At.ToString("O")">@item.At.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time>
                    @if (!isLast || Order.Status is not OrderStatus.Entregado and not OrderStatus.Cancelado)
                    {
                        <span class="journey-elapsed">@FormatElapsed(elapsed)</span>
                    }
                </div>
            </li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired] public Order Order { get; set; } = default!;

    private List<JourneyMilestone> milestones = [];

    protected override void OnParametersSet()
    {
        milestones = OrderJourneyHelper.BuildMilestones(Order);
    }

    private static string FormatElapsed(TimeSpan span)
    {
        if (span.TotalMinutes < 1) return "—";
        if (span.TotalHours < 1) return $"+{Math.Round(span.TotalMinutes)} min";
        if (span.TotalDays < 1) return $"+{span.TotalHours:F1} h";
        return $"+{span.TotalDays:F1} d";
    }
}
